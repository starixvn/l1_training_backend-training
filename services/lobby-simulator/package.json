{
    "name": "game-lobby-simulator",
    "version": "0.0.0",
    "private": true,
    "main": "src/app.js",
    "scripts": {
        "start": "nodemon ./src",
        "webpack:dev": "webpack --watch --mode development --config ./src/webpack.config.js",
        "dev": "set NODE_OPTIONS=--openssl-legacy-provider && concurrently --kill-others \"npm run webpack:dev\" \"nodemon .\"",
        "build": "set NODE_OPTIONS=--openssl-legacy-provider && webpack --config ./src/webpack.config.js"
    },
    "description": "GameLobbySimulator",
    "author": {
        "name": ""
    },
    "dependencies": {
        "@sentry/node": "^5.15.4",
        "body-parser": "^1.15.0",
        "cookie-parser": "^1.4.0",
        "cors": "^2.8.5",
        "debug": "^2.2.0",
        "express": "^4.14.0",
        "l1.client.node-js": "file:./src/L1.Client.NodeJS",
        "morgan": "^1.7.0",
        "nodemon": "^2.0.2",
        "pug": "^2.0.0-beta6",
        "react-qr-code": "^2.0.7",
        "serve-favicon": "^2.3.0"
    },
    "devDependencies": {
        "@babel/core": "^7.8.4",
        "@babel/plugin-transform-runtime": "^7.9.0",
        "@babel/preset-env": "^7.8.4",
        "@babel/preset-react": "^7.8.3",
        "@babel/runtime": "^7.9.2",
        "axios": "^0.19.2",
        "babel-loader": "^8.0.6",
        "concurrently": "^5.1.0",
        "history": "^4.10.1",
        "react": "^16.13.0",
        "react-dom": "^16.13.0",
        "react-router-dom": "^5.1.2",
        "webpack": "^4.42.0",
        "webpack-cli": "^3.3.11"
    }
}
