{
    "compilerOptions": {
        "target": "es2020",
        "lib": ["es2020"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "types": ["node"]
    },
    "include": ["src/_shared/tolgee-generator.ts"],
    "exclude": ["node_modules"]
}
