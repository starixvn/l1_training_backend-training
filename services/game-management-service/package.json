{
    "name": "sc-game-management-service",
    "version": "1.0.0",
    "description": "Game Management Service",
    "private": true,
    "license": "MIT",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest ./__test__/unit-tests --config ./jest-config.json",
        "test-coverage": "jest ./__test__/unit-tests --config ./jest-config.json --collect-coverage",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "integration-test": "jest ./__test__/integration-tests --config ./jest-config.json --maxWorkers=1 --forceExit",
        "integration-test-dev": "jest ./__test__/integration-tests --config ./jest-config.dev.json --maxWorkers=1 --forceExit",
        "reg": "npm set registry http://npm.lumigame.com",
        "pregen:client": "rimraf ./api-client/generated",
        "gen:client": "yarn openapi --input ./api-client/api-spec.json --output ./api-client/generated --client axios --name gameManagementClient && cp ./api-client/custom/CustomAxiosRequest.ts ./api-client/generated/",
        "gen:client-win": "yarn openapi --input ./api-client/api-spec.json --output ./api-client/generated --client axios --name gameManagementClient && copy .\\api-client\\custom\\CustomAxiosRequest.ts .\\api-client\\generated\\"
    },
    "dependencies": {
        "@fastify/helmet": "^11.1.1",
        "@fastify/static": "^6.12.0",
        "@nestjs/cache-manager": "^2.1.1",
        "@nestjs/common": "^10.0.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.0.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/mongoose": "7.2.2",
        "@nestjs/platform-fastify": "^10.2.10",
        "@nestjs/swagger": "^7.1.16",
        "@sentry/node": "^6.0.2",
        "cache-manager": "^5.3.2",
        "class-validator": "^0.14.0",
        "dotenv": "^16.3.1",
        "jest-extended": "^4.0.2",
        "jest-sonar-reporter": "^2.0.0",
        "jwks-rsa": "^3.1.0",
        "mongoose": "5.11.13",
        "openid-client": "^5.6.1",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1",
        "sc-instrument": "1.1.1-beta.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^13.1.0",
        "@commitlint/config-conventional": "^13.1.0",
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/cache-manager": "^4.0.6",
        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.2",
        "@types/node": "^20.3.1",
        "@types/supertest": "^2.0.12",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "husky": "^7.0.1",
        "jest": "^29.5.0",
        "jest-junit": "^16.0.0",
        "openapi-typescript-codegen": "^0.25.0",
        "prettier": "^3.0.0",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "testResultsProcessor": "jest-sonar-reporter",
        "setupFilesAfterEnv": [
            "jest-extended"
        ]
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    }
}
