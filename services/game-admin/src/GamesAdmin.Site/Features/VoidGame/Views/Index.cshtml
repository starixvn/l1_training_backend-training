@using GamesAdmin.Site.Features.VoidGame.ViewModels;
@using GamesAdmin.Site._Shared.ViewComponents
@model IndexViewModel;

@{
    ViewData["Title"] = "Void Game Ticket";
}

<div class="col-md-12 col-lg-5 card">
    @if (Model.Result != null && Model.Result.IsSuccessful() == true)
    {
        <div class="message-success hidden-cls" id="successMsg"><i class="icon-check"></i><span>Voided successfully</span></div>
    }

    @if (Model.Result != null && Model.Result.IsSuccessful() == false)
    {
        <div class="message-error hidden-cls" id="failedMsg">
            <i class="icon-cancel"></i>
            <span>Error: @Model.Result.ErrorCode - @Model.Result.ErrorMessage - @Model.Result.ErrorDescription</span>
        </div>
    }

    <form class="card-body form" asp-action="VoidTicket" asp-controller="VoidGame" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="PartnerId" class="control-label">Operator</label>
            <select asp-items="@Model.Partners" asp-for="PartnerId" class="form-control">
                <option value="" disabled selected></option>
            </select>
            <span asp-validation-for="PartnerId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MemberId" class="control-label"></label>
            <input type="text" asp-for="MemberId" class="form-control" />
            <span asp-validation-for="MemberId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="SiteId" class="control-label"></label>
            <input type="number" asp-for="SiteId" class="form-control" />
            <span asp-validation-for="SiteId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="GameRoundId" class="control-label"></label>
            <input type="number" asp-for="GameRoundId" class="form-control" />
            <span asp-validation-for="GameRoundId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="GameId" class="control-label"></label>
            @await Component.InvokeAsync(nameof(SelectGame), new { name="GameId" })
            <span asp-validation-for="GameId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Reason" class="control-label"></label>
            <input type="text" asp-for="Reason" class="form-control" />
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input type="checkbox" asp-for="FreeBet" />
            <label asp-for="FreeBet" class="control-label"></label>
        </div>

        <div class="form-group">
            <input type="submit" value="Submit" class="btn-submit" onclick="return confirmVoid();" />
        </div>
    </form>
</div>

@section Scripts{
    <script src="~/js/voidgame.min.js" asp-append-version="true"></script>
}