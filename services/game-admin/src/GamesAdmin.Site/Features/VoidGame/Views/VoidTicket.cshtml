@using GamesAdmin.Site.Features.VoidGame.ViewModels;
@model IndexViewModel;

@{
    ViewData["Title"] = "Void Game Ticket";
}

<div class="col-md-12 col-lg-5 card">
    @if (Model.Result != null && Model.Result.IsSuccessful() == true)
    {
        <div class="message-success hidden-cls" id="successMsg"><i class="icon-check"></i><span>@Model.MessageSuccessful</span></div>
    }

    @if (Model.Result != null && Model.Result.IsSuccessful() == false)
    {
        <div class="message-error hidden-cls" id="failedMsg">
            <i class="icon-cancel"></i>
            <span>Error: @Model.Result.ErrorCode - @Model.Result.ErrorMessage - @Model.Result.ErrorDescription</span>
        </div>
    }

    <form class="card-body form">
        <div class="form-group">
            <label asp-for="PartnerId" class="control-label">Operator</label>
            <select asp-items="@Model.Partners" asp-for="PartnerId" class="form-control" disabled></select>
        </div>

        <div class="form-group">
            <label asp-for="MemberId" class="control-label"></label>
            <input type="text" asp-for="MemberId" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="SiteId" class="control-label"></label>
            <input type="number" asp-for="SiteId" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="GameRoundId" class="control-label"></label>
            <input type="number" asp-for="GameRoundId" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="GameId" class="control-label"></label>
            <select asp-items="@Model.GameIds" asp-for="GameId" class="form-control" disabled></select>
        </div>

        <div class="form-group">
            <label asp-for="Reason" class="control-label"></label>
            <input type="text" asp-for="Reason" class="form-control" readonly />
        </div>

        <div class="form-group">
            <input type="checkbox" asp-for="FreeBet" disabled />
            <label asp-for="FreeBet" class="control-label"></label>
        </div>
    </form>
    <a asp-action="Index" asp-controller="VoidGame">
        Void Another Ticket
    </a>
</div>