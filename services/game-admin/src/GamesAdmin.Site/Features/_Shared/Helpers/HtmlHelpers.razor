@functions {
    public static string formatNumber(decimal value)
    {
        if (value == 0)
        {
            return "0";
        }
        return value.ToString("#,##0.00");
    }

    public static string formatNumber(decimal? value)
    {
        return value.HasValue ? formatNumber(value.Value) : string.Empty;
    }

    public static string formatNumber2(decimal? value)
    {
        return value.HasValue ? formatNumber(value.Value) : string.Empty;
    }

    public static string convertByExchangeRate(decimal? value, decimal? rate)
    {
        var exchangeRate = !rate.HasValue || rate == 0 ? 1 : rate;

        return value == null ? string.Empty : formatNumber(value / exchangeRate);
    }

    public static string formatNumber3(double value)
    {
        return value.ToString("#,##0.##");
    }

    public static decimal formatOdds(decimal value, bool fractionalOddsFormat)
    {
        return fractionalOddsFormat ? value - 1 : value;
    }

    public static string formatOddsWithZero(decimal value, bool fractionalOddsFormat)
    {
        if(value == 0)
        {
            return "-";
        }
        else
        {
            return formatOdds(value, fractionalOddsFormat).ToString();
        }        
    }
}