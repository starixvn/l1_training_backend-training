@model GamesAdmin.Site.Features.CurrencyGroups.ViewModels.UpdateCurrencyGroupViewModel

<div class="modal-header">
    <h5 class="modal-title">Edit currency group</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<form data-ajax="true" class="form" asp-action="Update" method="post" id="update-currency-group-form"
      data-ajax-success="currencyGroup.onUpdateCurrencyGroupSuccess">
    <div class="modal-body">
        <input class="form-control" type="text" asp-for="Id" hidden>
        <div class="form-group row">
            <div class="col-sm-12">
                <label class="required-field-label" asp-for="PartnerId">Operator</label>
                <select class="form-control" asp-for="PartnerId" asp-items="@Model.PartnerItems"></select>
                <span class="text-danger" asp-validation-for="PartnerId"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-sm-12">
                <label class="required-field-label" asp-for="Name">Currency Group</label>
                <input class="form-control" type="text" asp-for="Name">
                <span class="text-danger" asp-validation-for="Name"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-sm-12">
                <label asp-for="Currencies">Currency</label>
                <select class="form-control currencies-class" hidden asp-for="Currencies" asp-items="@Model.CurrencyItems" multiple></select>
                <select class="form-control" id="currencies-update"></select>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-sm-12">
                <input type="checkbox" asp-for="Enabled" />
                <label asp-for="Enabled" class="control-label"></label>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-sm-12">
                <input type="checkbox" asp-for="FractionalOddsFormat" />
                <label asp-for="FractionalOddsFormat" class="control-label">Apply Fractional Odds Format</label>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-sm-12">
                <label class="control-label" id="result-label"></label>
            </div>
        </div>
    </div>
    <div class=" modal-footer">
        <button type="button" class="btn-gray" data-dismiss="modal">Close</button>
        <button type="submit" class="btn-submit">Save</button>
    </div>
</form>