@using GamesAdmin.Site.Features.CurrencyGroupGames.ViewModels;
@model EditViewModel;

@{
    Layout = null;
    ViewData["Title"] = Model.GameName;
}


<form class="card-body form" id="currencyGroupGameForm">
    <div>
        <input asp-for="GameId" type="hidden" class="form-control" />

        <div class="form-group">
            <input type="checkbox" asp-for="Enabled" />
            <label asp-for="Enabled" class="control-label"></label>
        </div>
        @if (Model.DisplayMinMaxBet)
        {
            <div class="form-group row">
                <div class="col-lg-6">
                    <label asp-for="@Model.MinBet" class="control-label"></label>
                    <input type="number" asp-for="@Model.MinBet" class="form-control" />
                </div>
                <div class="col-lg-6">
                    <label asp-for="@Model.MaxBet" class="control-label"></label>
                    <input type="number" asp-for="@Model.MaxBet" class="form-control" />
                </div>
            </div>
        }

        @if (Model.DisplayMaxBetPerChoice)
        {
            <fieldset>
                <legend>Bet Choices</legend>
                @for (var i = 0; i < (Model.MaxBetChoiceSetting.Count / 2 + 1); i++)
                {
                    <div class="form-group row">
                        @for (var j = 0; j < 2; j++)
                        {
                            var index = i * 2 + j;
                            if (index < Model.MaxBetChoiceSetting.Count)
                            {
                                <div class="col-lg-6">
                                    <label class="control-label">@Model.MaxBetChoiceSetting[index].DisplayName</label>
                                    <input type="text" hidden asp-for="@Model.MaxBetChoiceSetting[index].Name" class="form-control" />
                                    <input type="number" asp-for="@Model.MaxBetChoiceSetting[index].MaxBet" class="form-control" />
                                </div>
                            }
                        }
                    </div>
                }
            </fieldset>
        }
        <br />


        @if (Model.GameType == GamesAdmin.Core.Enumeration.GameType.CascadingSlots)
        {
            <fieldset>
                <legend>Coin Values <span class="note">(Set the default value by selecting the radio-button on each Coin Value)</span></legend>
                <div class="form-group" id="coin-values">
                    <input type="hidden" id="coins-length" value="@Model.CoinValues.Length" class="form-control" />
                    @for (var i = 0; i < Model.CoinValues.Length; i++)
                    {
                        <div class="form-group row">
                            <input type="radio" class="mr-3 ml-3" asp-for="DefaultCoinValue" value="@Model.CoinValues[i]" />
                            <input id="coin-value-@i" type="number" asp-for="@Model.CoinValues[i]" class="col-2 form-control txt-coin-value"
                                   data-val-range="The field MaxWinPerRound must be between 5E-324 and 1.7976931348623157E+308." 
                                   data-val-range-max="1.7976931348623157E+308" 
                                   data-val-range-min="5E-324"
                                   data-val-unique="Value should be unique" 
                                   />
                            <i class="icon-cancel text-error mt-3 ml-4" style="cursor: pointer" onclick="currencyGroupGame.removeCoinValue(event)"></i>
                        </div>
                    }
                    <div class="add-container">
                        <button type="button" class="btn btn-add" id="addCoinValueBtn" onclick="currencyGroupGame.addCoin()">Add new Coin value</button>
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>Max Win per Round</legend>
                <div class="form-group row">
                    <div class="col-lg-4">
                        <input type="number" asp-for="@Model.MaxWinPerRound" class="form-control" />
                    </div>
                </div>
            </fieldset>
        }
        else if (Model.GameType == GamesAdmin.Core.Enumeration.GameType.Slots)
        {
            @if (Model.StakeLevels?.Length > 0)
            {
                <fieldset>
                    <legend>Stake Levels</legend>
                    <div class="form-group row">
                        @for (var i = 0; i < Model.StakeLevels.Length; i++)
                        {
                            <div class="col-lg-4">
                                <label class="control-label">@($"Level {i + 1}")</label>
                                <input id="stake-level-@i" type="number" asp-for="@Model.StakeLevels[i].Stake" class="form-control" disabled />
                            </div>
                        }
                    </div>
                </fieldset>
            }
            else
            {
                <fieldset>
                    <legend>Bet Levels</legend>
                    <p>Set the default value by selecting the radio-button on each Bet Level</p>
                    <div class="form-group" id="bet-levels">
                        <input type="hidden" id="bet-level-length" value="@Model.BetLevels.Length" class="form-control" />
                        <div class="form-group row">
                            <label class="pl-5 mr-5 pr-5"><b>Bet per line</b></label>
                            <label class="pl-5 ml-5 text-center"><b>Total Bet</b> <br /> (on 25 fixed paylines)</label>
                        </div>

                        @for (var i = 0; i < Model.BetLevels.Length; i++)
                        {
                            <div class="form-group row">
                                <input type="radio" class="mr-3 ml-3" asp-for="DefaultBetLevel" value="@Model.BetLevels[i]" />
                                <input id="bet-level-@i" type="number" asp-for="@Model.BetLevels[i]" class="col-2 form-control txt-bet-level"
                                       step=".01"
                                       data-val-range="The field MaxWinPerRound must be between 5E-324 and 1.7976931348623157E+308."
                                       data-val-range-max="1.7976931348623157E+308"
                                       data-val-range-min="5E-324"
                                       data-val-unique="Value should be unique"
                                       oninput="currencyGroupGame.updateTotalBet(this.value,@i)" />
                                <i class="icon-cancel text-error mt-3 ml-4 mr-5" style="cursor: pointer" onclick="currencyGroupGame.removeBetLevel(event)"></i>
                                <label class=" mt-3 ml-5 pl-5" id="total-bet-@i">@((decimal)Model.BetLevels[i] * 25m)</label>
                            </div>
                        }


                        <div class="add-container">
                            <button type="button" class="btn btn-add" id="addBetLevelBtn" onclick="currencyGroupGame.addBetLevel()">Add new Bet Level</button>
                        </div>
                    </div>
                </fieldset>
            }
        }
        else
        {
            <fieldset>
                <legend>Stake</legend>
                @for (var j = 0; j < (Model.AllChips.Count / 6 + 1); j++)
                {
                    <div class="form-group row">
                        @for (var k = 0; k < 6; k++)
                        {
                            var index = j * 6 + k;
                            if (index < Model.AllChips.Count)
                            {
                                var displayName = Model.AllChips[index].Text;
                                <div class="col-lg-2" id="chip-collector">
                                    <input type="checkbox" name="chip-@(index)" id="chip-@(index)" value="@Model.AllChips[index].Value" checked="@Model.Chips?.Contains(Model.AllChips[index].Value)" />
                                    <label class="control-label" for="chip-@(index)">@displayName</label>

                                    <input type="text" hidden asp-for="@Model.AllChips[index].Id" />
                                </div>
                            }
                        }
                    </div>
                }
            </fieldset>
        }
        <br />
    </div>
</form>