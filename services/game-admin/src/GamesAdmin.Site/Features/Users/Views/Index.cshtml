@using GamesAdmin.Site.Features.Users.ViewModels;
@model IndexViewModel;

@{
    ViewData["Title"] = "Users";
}


<div class="col-md-12 col-lg-6 p-0">
    <table class="table table-bordered has-background">
        <thead>
            <tr>
                <th>Username</th>
                <th>IsAdmin</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Users)
            {
                <tr>
                    <td>@item.Username</td>
                    <td>@item.IsAdmin</td>
                </tr>
            }
        </tbody>
    </table>
</div>

