@model GamesAdmin.Site.Features.Chips.ViewModels.ChipManagementViewModel
@using GamesAdmin.Site.Features._Shared;

@section Styles {
    <link href="~/css/chip.min.css" rel="stylesheet" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Chip";
}

@if (Context.HasAdminPermission())
{
    <div>
        <a class="btn-add" data-ajax="true" data-ajax-mode="replace" data-ajax-update="#modal .modal-content" data-ajax-success="chip.openAddChipForm" asp-action="Create">
            Add Chip
        </a>
    </div>
}

<div id="chip-management" class="card">
    <div class="card-body">
        <table id="chip-table" class="table table-bordered table-hover stripe sticky-table">
            <thead>
                <tr>
                    <th>Text</th>
                    <th>Value</th>
                    <th>Color</th>
                    @if (Context.HasAdminPermission())
                    {
                        <th>Edit</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Models)
                {
                    <tr>
                        <td class="text-center">@item.Text</td>
                        <td class="text-center">@item.Value</td>
                        <td class="text-center">
                            <input disabled class="color form-control" value="@item.Color" />
                        </td>
                        @if (Context.HasAdminPermission())
                        {
                            <td class="text-center">
                                <a class="btn-edit" data-ajax="true" data-ajax-mode="replace" data-ajax-update="#modal .modal-content" data-ajax-success="chip.openUpdateChipForm"
                                   asp-route-id=@item.Id
                                   asp-action="Update">
                                    <i class="icon-edit"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modal" tabindex="-1" role="dialog" aria-labelledby="modal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>

@section Scripts
{
    <environment include="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
        <script type="text/javascript" src="~/lib/data-tables/datatables.js"></script>
        <script type="text/javascript" src="~/lib/spectrum/spectrum.min.js"></script>
        <script src="~/js/chip.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/chip.min.js" asp-append-version="true"></script>
    </environment>
}