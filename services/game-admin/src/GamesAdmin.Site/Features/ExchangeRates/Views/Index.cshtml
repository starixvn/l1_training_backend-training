@model GamesAdmin.Site.Features.ExchangeRates.ViewModels.IndexViewModel

@section Styles {
    <link href="~/css/exchange-rate.min.css" rel="stylesheet" asp-append-version="true" />
}

@{
    ViewData["Title"] = "OANDA Exchange Rate";
}

<form class="form filter" data-ajax="true" data-ajax-method="GET" asp-action="Query"
      data-ajax-mode="replace"
      data-ajax-update="#exchange-rate .card-body"
      data-ajax-loading="#spinner"
      data-ajax-success="exchangeRate.init"
      id="exchange-rate-form">
    <div class="form-row align-items-center">
        <div class="col-auto">
            <label asp-for="From" class="control-label"></label>
            <input type="date" class="form-control" asp-for="From">
        </div>
        <div class="col-auto">
            <label asp-for="To" class="control-label"></label>
            <input type="date" class="form-control" asp-for="To">
        </div>
        <div class="col-auto list-buttons">
            <button type="submit" class="btn-submit">Submit</button>
            <div id="spinner" class="spinner-border" style="display: none">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
    </div>
</form>

<div id="exchange-rate" class="card">
    <div class="card-body">
    </div>
</div>

@section Scripts
{
    <environment include="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
        <script type="text/javascript" src="~/lib/data-tables/datatables.js"></script>
        <script src="~/js/exchange-rate.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/exchange-rate.min.js" asp-append-version="true"></script>
    </environment>
}