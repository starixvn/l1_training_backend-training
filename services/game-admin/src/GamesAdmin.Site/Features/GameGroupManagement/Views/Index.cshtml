@model GamesAdmin.Site.Features.GameGroupManagement.ViewModels.GameGroupManagementViewModel
@using GamesAdmin.Site.Features._Shared;

@{
    ViewData["Title"] = "Game Group Management";
}

@section Styles {
    <link href="~/lib/fanex.multiselect/fanex.multiSelect.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/game-group-management.min.css" rel="stylesheet" asp-append-version="true" />
}

<div id="game-group-management" class="card">
    <div class="card-body">
        @if (Context.HasAdminPermission())
        {
            <div class="list-action">
                <a type="button" class="btn-add" data-ajax="true" data-ajax-mode="replace" data-ajax-update="#modal .modal-content" data-ajax-success="gameGroupManagement.openCreateForm" asp-action="Create">
                    Add New Group
                </a>
            </div>
        }

        <table id="game-group-table" class="table table-bordered table-hover stripe sticky-table">
            <thead>
                <tr>
                    <th>Group Name</th>
                    <th>Games</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model.GameGroups)
                {
                    <tr>
                        <td class="text-center">@group.Name</td>
                        <td class="text-center">@group.DisplayGames</td>
                        <td class="text-center">
                            @if (Context.HasAdminPermission())
                            {
                                <a class="btn-edit" data-ajax="true" data-ajax-mode="replace" data-ajax-update="#modal .modal-content" data-ajax-success="gameGroupManagement.openUpdateForm"
                           asp-route-groupId="@group.Id"
                           asp-action="Update">
                                    <i class="icon-edit"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modal" tabindex="-1" role="dialog" aria-labelledby="modal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>

@section Scripts
    {
    <environment include="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
        <script type="text/javascript" src="~/lib/data-tables/datatables.js"></script>
        <script type="text/javascript" src="~/lib/fanex.multiselect/fanex.multiSelect.js"></script>
        <script src="~/js/game-group-management.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/game-group-management.min.js" asp-append-version="true"></script>
    </environment>
}