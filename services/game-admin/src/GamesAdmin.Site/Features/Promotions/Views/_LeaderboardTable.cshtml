@using GamesAdmin.Site.Features._Shared;
@using GamesAdmin.Core.Extensions;
@using GamesAdmin.Core.Models.Promotion;
@using GamesAdmin.Site.Extensions;

@model IEnumerable<AwardWinningPlayer>
@{
    var hasAdminPermission = Context.HasAdminPermission();
    var isCompleted = Model.FirstOrDefault()?.CompletedPromotion ?? false;
    var isTestCurrency = Model.FirstOrDefault()?.IsTestCurrency ?? false;
    var promotionId = Model.FirstOrDefault()?.PromotionId ?? 0;
}

<table id="leaderboard-table" class="table table-bordered stripe table-light">
    <thead>
        <tr>
            <th>Ranking</th>
            <th>Operator</th>
            <th>Player name</th>
            <th>Nickname</th>
            <th>Currency</th>
            <th>Site name</th>
            <th>Total points</th>
            @if (isCompleted)
            {
                if (!isTestCurrency)
                {
                    <th>Reward Amount</th>
                }
                <th>Paid Status</th>
                <th>Paid Date (GMT +7)</th>
            }
        </tr>
    </thead>
    <tbody>
        @{
            foreach (var item in Model)
            {
                <tr class="text-center">
                    <td>@(item.IsTestCurrency ? "-" : item.Ranking.ToString())</td>
                    <td>@item.OperatorName</td>
                    <td>@item.PlayerName</td>
                    <td>@item.Nickname</td>
                    <td>@item.Currency</td>
                    <td>@item.SiteName</td>
                    <td>@item.Point</td>
                    @if (isCompleted)
                    {
                        if (!isTestCurrency)
                        {
                            <td>@(item.AwardedAmount > 0 ? item.AwardedAmount.ToString() : "")</td>
                        }
                        <td>
                            @if (item.IsAwarded)
                            {
                                <span>Paid</span>
                            }
                            else
                            {
                                if (!item.IsTestCurrency && item.AwardedAmount > 0)
                                {
                                    <span>Unpaid</span>
                                }
                                @if (item.IsTestCurrency && hasAdminPermission)
                                {
                                    <button type="button" class="btn btn-info btn-lg"
                                            onclick="promotionLeaderboard.openAwardTestPlayer('@item.OperatorId','@item.OperatorName','@item.PlayerId','@item.PlayerName','@item.Currency',@item.Point,@item.AwardedAmount)">
                                        Confirm Payment
                                    </button>
                                }
                            }
                        </td>
                        <td>@(item.IsAwarded ? @item.AwardedTime.AddHours(DateTimeExtension.AsianGMT).ToDateTimeFormat() : "")</td>
                    }
                </tr>
            }
        }
    </tbody>
</table>

@if (isCompleted && !isTestCurrency && hasAdminPermission && Model.Any(e => e.IsAwarded != true && e.AwardedAmount > 0))
{
    <div class="text-center">
        <button class="btn-add" id="btn-confirm-payment" onclick="promotionLeaderboard.openAwardTournamentModal(@promotionId)">Confirm payment</button>
    </div>
}