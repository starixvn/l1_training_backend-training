@using System.Text;
@using GamesAdmin.Core.Models.Promotion;

@model IEnumerable<AwardWinningPlayer>


<table class="table table-light table-bordered stripe">
    <thead>
        <tr class="text-center">
            <th>Ranking</th>
            <th>Operator</th>
            <th>Player name</th>
            <th>Currency</th>
            <th>Total points</th>
            <th>Reward Amount</th>
        </tr>
    </thead>
    <tbody>
        @{
            foreach (var item in Model)
            {
                if (item.AwardedAmount > 0 && !item.IsAwarded)
                {
                    <tr class="text-center">
                        <td>@item.Ranking</td>
                        <td>@item.OperatorName</td>
                        <td>@item.PlayerName</td>
                        <td>@item.Currency</td>
                        <td>@item.Point</td>
                        <td>@item.AwardedAmount</td>
                    </tr>
                }
            }
        }
    </tbody>
</table>
