@using GamesAdmin.Site.Extensions;
@using GamesAdmin.Site.Features.Promotions.ViewModels;
@using GamesAdmin.Site._Shared.Configurations;
@inject IAppSettings appSetting;
@model PromotionCampaignViewModel;
<div class="modal-header">
    <h5 class="modal-title">Add New Promotion</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
@{
    Model.ConvertToTimeZone(appSetting.DefaultTimeZone);
}
<form class="form" id="add-new-tournament-form">
    <div class="col-12 mt-3 modal-body">
        <div class="form-group">
            <div class="col-12 row">
                <label class="control-label col-3 pt-3 bold" asp-for="Name">Promotion name:</label>
                <input type="text" class="form-control col-9 bold" asp-for="Name" value="@Model.Name">
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>          
        </div>
        <div class="form-group">
            <label class="control-label col-3 pt-3 bold">Start date</label>
            <div class="form-group">
                <div class="col-12 row">
                    <label asp-for="StartDate" class="control-label col-3 pt-3">Date (GMT+7):</label>
                    <input type="date" class="form-control col-3 mb-3" asp-for="StartDate">
                </div>
                <div class="col-12 row">
                    <label asp-for="StartTime" class="control-label col-3 pt-3">Time (GMT+7):</label>
                    <input type="text" class="form-control col-3 time-picker" asp-for="StartTime" value="@Model.StartTime.ToTimeFormat()">
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-3 pt-3 bold">End date</label>
            <div class="form-group">
                <div class="col-12 row">
                    <label asp-for="EndDate" class="control-label col-3 pt-3">Date (GMT+7):</label>
                    <input type="date" class="form-control col-3 mb-3" asp-for="EndDate">
                </div>
                <div class="col-12 row">
                    <label asp-for="EndTime" class="control-label col-3 pt-3">Time (GMT+7):</label>
                    <input type="text" class="form-control col-3 time-picker" asp-for="EndTime" value="@Model.EndTime.ToTimeFormat()">
                </div>
            </div>
        </div>    
        <fieldset class="form-group mt-3 pb-3">
            <legend>Prize</legend>
            <div id="prize-list" class="form-goup">
                @for (var i = 0; i < Model?.WinningPrizes?.Count(); i++)
                {
                    <div class="form-row" id="prize-row-@i">
                        <div class="form-group col-md-2" id="ranking-col-@i">
                            <label>Ranking</label>
                            <input id="ranking-input-@i" type="text" asp-for="@Model.WinningPrizes[i].Ranking" value="@Model.WinningPrizes[i].Ranking" class="form-control text-center"
                                   data-val="true"
                                   data-val-required="The Ranking field is required."
                                   data-val-range="The field Ranking must be a valid value."
                                   data-val-unique="Value should be unique" />
                        </div>
                        <div class="form-group col-md-3" id="amount-col-@i">
                            <label>Win Amount</label>
                            <input id="win-amount-@i" type="number" asp-for="@Model.WinningPrizes[i].Value"
                                   class="form-control text-center"
                                   data-val-range="The field Value must be between 1 and 2147483647."
                                   data-val-range-max="2147483647"
                                   data-val-range-min="1"
                                   data-val-unique="Value should be unique"
                                   value="@Model.WinningPrizes[i].Value" />
                        </div>
                        <div class="form-group col-md-1 d-flex align-items-center">
                            <i id="remove-col-@i" class="icon-cancel text-error mt-4 ml-4" style="cursor: pointer" onclick="promotion.removeRanking(@i)"></i>
                        </div>
                    </div>
                }
            </div>
            <span id="prizeError" hidden class="text-danger">You must have at least one prize.</span>
            <span id="orderError" hidden class="text-danger">Please ensure that Ranking is in ascending order and Win Amount is in descending order.</span>
            <div class="add-container">
                <button type="button" class="btn btn-add" id="addRankingBtn" onclick="promotion.addRanking()">Add more</button>
            </div>
        </fieldset>
        <label class="hidden" id="result-label"></label>
    </div>
    <div class=" modal-footer">
        <button type="button" class="btn-gray" data-dismiss="modal">Close</button>
        <button type="button" onclick="promotion.onCreateTournament()" class="btn-submit">Save</button>
    </div>
</form>