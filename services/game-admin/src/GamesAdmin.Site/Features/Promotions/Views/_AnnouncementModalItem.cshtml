@using System.Text;
@using GamesAdmin.Site.Features.Promotions.ViewModels;
@using GamesAdmin.Core.Enumeration;
@using GamesAdmin.Site.Extensions;
@using GamesAdmin.Site._Shared.Configurations;
@inject IAppSettings appSetting;
@model CreateAnnouncementItemViewModel

@{
    var unique = string.IsNullOrEmpty(Model.Id) ? DateTime.Now.Ticks.ToString() : Model.Id;
    var numberOfLanguage = Language.EmptyLanguages.Count;
    Model.ConvertToTimeZone(appSetting.DefaultTimeZone);
}
@functions{
    private void RenderMessageRow(string language, string unique, string title, string message)
    {
        <tr class="announcement-item-@unique">
            <td class="text-center">@language</td>
            <td class="text-center">
                <div class="input-group">
                    <input type="text" class="form-control" required id="title-@language-@unique" value="@title" />
                </div>
            </td>
            <td class="text-center">
                <div class="input-group">
                    <textarea class="form-control" rows="2" id="message-@language-@unique">@message</textarea>
                </div>
            </td>
        </tr>
    }
}
<tr class="announcement-item-@unique">
    <td class="text-center item-index" rowspan="@numberOfLanguage">1</td>
    <td class="text-center" rowspan="@numberOfLanguage">
        <input type="text" hidden asp-for="Id" id="id-@unique" class="input-announcement-id" value="@unique" />
        <input type="text" hidden class="input-announcement-unique" value="@unique" />
        <input type="text" hidden id="happyhours-@unique" value="@NotificationDisplayKind.PromotionValue" />
        <input type="text" hidden id="tournament-@unique" value="@NotificationDisplayKind.PromotionCampaignValue" />
        <div class="form-check">
            <label class="form-check-label">
                <input type="checkbox" class="form-check-input" id="enabled-@unique" asp-for="Enabled">
                Enabled
            </label>
        </div>
    </td>
    <td class="text-center">@Language.EN</td>
    <td class="text-center">
        <div class="input-group">
            <input type="text" asp-for="Title[Language.EN]" class="form-control" id="title-@Language.EN-@unique" required />
        </div>
    </td>
    <td class="text-center">
        <div class="input-group">
            <textarea class="form-control" rows="2" asp-for="Messages[Language.EN]" id="message-@Language.EN-@unique"></textarea>
        </div>
    </td>
    <td class="text-center" rowspan="@numberOfLanguage">
        <div>
            <label asp-for="StartTime">From</label>
            <input type="text" class="form-control time-picker" asp-for="StartTime" value="@Model.StartTime.ToString(DateTimeExtensions.DateTimeFormat)" id="startTime-@unique">
        </div>
        <br />
        <div>
            <label asp-for="EndTime">To</label>
            <input type="text" class="form-control time-picker" asp-for="EndTime" value="@Model.EndTime.ToString(DateTimeExtensions.DateTimeFormat)" id="endTime-@unique">
        </div>
    </td>
    @if (Model.DisplayKind == null)
    {    
        <td class="text-center" rowspan="@numberOfLanguage">
            <div class="form-group">
                <label>Type</label>
                <div>
                    <select asp-items="Model.PromotionTypeList" class="form-control select-promotion-mapping" id="promotionType-@unique" onchange="promotionAnnouncement.togglePromotionType(this, '@unique')"></select>
                </div>
            </div>
            <div class="form-group">
                <label>Mapping</label>
                <span id="promotionListContainer-@unique">
                    <select asp-items="@Model.PromotionListItem" asp-for="PromotionId" class="form-control select-promotion-mapping" id="promotionId-@unique-promotion"></select>
                </span>
                <span id="promotionCampaignListContainer-@unique" hidden>
                    <select asp-items="@Model.PromotionCampaignListItem" asp-for="PromotionId" class="form-control select-promotion-mapping" id="promotionId-@unique-campaign"></select>
                </span>
            </div>
        </td>
    }
    else
    {
        @if (Model.IsHappyHoursAnnouncement)
        {          
            <td class="text-center" rowspan="@numberOfLanguage">
                <label>Type: @Model.DisplayKind</label>
                <select asp-items="@Model.PromotionListItem" asp-for="PromotionId" class="form-control select-promotion-mapping" id="promotionId-@unique"></select>
            </td>
        }
        else
        {
            <td class="text-center" rowspan="@numberOfLanguage">
                <label>Type: @Model.DisplayKind</label>
                <select asp-items="@Model.PromotionCampaignListItem" asp-for="PromotionId" class="form-control select-promotion-mapping" id="promotionId-@unique"></select>
            </td>
        }
    }

   
    @if (string.IsNullOrEmpty(Model.Id))
    {
        <td class="text-center" rowspan="@numberOfLanguage">
            <button type="button" class="btn btn-danger btn-lg" onclick="promotionAnnouncement.deleteItem('@unique')">
                Delete
            </button>
        </td>
    }
</tr>
@{
    RenderMessageRow(Language.VN, unique, Model.Title.ContainsKey(Language.VN) ? Model.Title[Language.VN] : string.Empty, Model.Messages.ContainsKey(Language.VN) ? Model.Messages[Language.VN] : string.Empty);
    RenderMessageRow(Language.CN, unique, Model.Title.ContainsKey(Language.CN) ? Model.Title[Language.CN] : string.Empty, Model.Messages.ContainsKey(Language.CN) ? Model.Messages[Language.CN] : string.Empty);
    RenderMessageRow(Language.TW, unique, Model.Title.ContainsKey(Language.TW) ? Model.Title[Language.TW] : string.Empty, Model.Messages.ContainsKey(Language.TW) ? Model.Messages[Language.TW] : string.Empty);
    RenderMessageRow(Language.TH, unique, Model.Title.ContainsKey(Language.TH) ? Model.Title[Language.TH] : string.Empty, Model.Messages.ContainsKey(Language.TH) ? Model.Messages[Language.TH] : string.Empty);
    RenderMessageRow(Language.ID, unique, Model.Title.ContainsKey(Language.ID) ? Model.Title[Language.ID] : string.Empty, Model.Messages.ContainsKey(Language.ID) ? Model.Messages[Language.ID] : string.Empty);
    RenderMessageRow(Language.JA, unique, Model.Title.ContainsKey(Language.JA) ? Model.Title[Language.JA] : string.Empty, Model.Messages.ContainsKey(Language.JA) ? Model.Messages[Language.JA] : string.Empty);
    RenderMessageRow(Language.ES, unique, Model.Title.ContainsKey(Language.ES) ? Model.Title[Language.ES] : string.Empty, Model.Messages.ContainsKey(Language.ES) ? Model.Messages[Language.ES] : string.Empty);
}