@model GamesAdmin.Site.Features.DailySummary.ViewModels.DailySummaryViewModel

<form class="form filter" id="daily-summary-form">
    <div class="form-row align-items-center">
        <div class="col-auto">
            <label asp-for="OperatorId" class="control-label">OperatorId</label>
            <select asp-items="@Model.OperatorItem" asp-for="OperatorId" class="form-control"></select>
        </div>
        <div class="col-auto">
            <label asp-for="Date" class="control-label">Date (UTC)</label>
            <input type="date" class="form-control" asp-for="Date" />
        </div>
        <div class="col-auto">
            <label asp-for="SiteId" class="control-label">Site Id</label>
            <input type="text" class="form-control" asp-for="SiteId" />
        </div>
        <div class="col-auto list-buttons">
            <button type="submit" class="btn-submit">Submit</button>
        </div>
    </div>
</form>
<fieldset class="card daily-summary-field d-none mt-3">
    <pre id="daily-summary-result"></pre>
</fieldset>

@section Scripts
{
    <environment include="Development">
        <script src="~/js/daily-summary.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/daily-summary.min.js" asp-append-version="true"></script>
    </environment>
}
