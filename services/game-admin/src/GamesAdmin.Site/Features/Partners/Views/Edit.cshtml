@using GamesAdmin.Site.Features.Partners.ViewModels;

@model PartnerEditViewModel;

<div class="col-md-12 col-lg-12 card">
    <div class="message-success hidden-cls" id="successMsg"><i class="icon-check"></i><span>Updated successfully</span></div>
    <div class="message-error hidden-cls" id="failedMsg"><i class="icon-cancel"></i><span>Error</span></div>
    <form class="card-body form-add form" data-ajax="true" data-ajax-success="partner.upsertResultHandle" asp-controller="Partner" asp-action="Edit" method="Post" id="editForm">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label class='required-field-label' asp-for="PartnerId" class="control-label"></label>
            <input type="text" asp-for="PartnerId" readonly class="form-control" />
            <span asp-validation-for="PartnerId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class='required-field-label' asp-for="Name" class="control-label"></label>
            <input type="text" asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class='required-field-label' asp-for="SecretKey" class="control-label"></label>
            <input type="text" asp-for="SecretKey" class="form-control" />
            <span asp-validation-for="SecretKey" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class='required-field-label' asp-for="ClubVersionUrl" class="control-label"></label>
            <input type="text" asp-for="ClubVersionUrl" class="form-control" />
            <span asp-validation-for="ClubVersionUrl" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MiniVersionUrl" class="control-label"></label>
            <input type="text" asp-for="MiniVersionUrl" class="form-control" />
            <span asp-validation-for="MiniVersionUrl" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MobiVersionUrl" class="control-label"></label>
            <input type="text" asp-for="MobiVersionUrl" class="form-control" />
            <span asp-validation-for="MobiVersionUrl" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MegaKenoUrl" class="control-label"></label>
            <input type="text" asp-for="MegaKenoUrl" class="form-control" />
            <span asp-validation-for="MegaKenoUrl" class="text-danger"></span>
        </div>

         <div class="form-group">
            <label asp-for="MobileDirectUrl" class="control-label"></label>
            <input type="text" asp-for="MobileDirectUrl" class="form-control" />
            <span asp-validation-for="MobileDirectUrl" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class='required-field-label' asp-for="TestCurrencyUrl" class="control-label"></label>
            <input type="text" asp-for="TestCurrencyUrl" class="form-control" />
            <span asp-validation-for="TestCurrencyUrl" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class='required-field-label' asp-for="LivestreamingPlatformUrl" class="control-label"></label>
            <input type="text" asp-for="LivestreamingPlatformUrl" class="form-control" />
            <span asp-validation-for="LivestreamingPlatformUrl" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class='required-field-label' asp-for="OriginalGamesUrl" class="control-label"></label>
            <input type="text" asp-for="OriginalGamesUrl" class="form-control" />
            <span asp-validation-for="OriginalGamesUrl" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input type="checkbox" asp-for="IsDisplayPlayerCurrency" />
            <label asp-for="IsDisplayPlayerCurrency" class="control-label"></label>
        </div>

        <div class="form-group">
            <label class='required-field-label' asp-for="Alias" class="control-label"></label>
            <input type="text" asp-for="Alias" class="form-control" />
            <span asp-validation-for="Alias" class="text-danger"></span>
        </div>


        <div class="form-group text-right">
            <button type="button" class="btn-gray m-1" data-dismiss="modal">Close</button>
            <input type="submit" id="submitBtn" value="Update" class="btn-submit m-1" />
        </div>
    </form>
</div>