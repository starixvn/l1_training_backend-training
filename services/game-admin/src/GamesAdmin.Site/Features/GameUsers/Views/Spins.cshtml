@using GamesAdmin.Site.Features.GameUsers.ViewModels;

@model GetSpinViewModel

@{
    ViewData["Title"] = "Member Spins";
}

@section Styles {
    <link href="~/css/big-small-reports.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/vietlottkeno.min.css" rel="stylesheet" asp-append-version="true" />
}

<form class="form filter" data-ajax="true" data-ajax-method="GET"
      asp-action="GetMemberSpins"
      data-ajax-mode="replace"
      data-ajax-update="#member-spins"
      data-ajax-loading="#spinner"
      method="get">
    <div class="form-row align-items-center">
        <div class="col-auto">
            <label asp-for="MemberId" class="control-label"></label>
            <input type="number" class="form-control" asp-for="MemberId">
        </div>
        <div class="col-auto mt-5">
            <button type="submit" class="btn-submit">Submit</button>
            <div id="spinner" class="spinner-border" style="display: none">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
    </div>
</form>

<div id="member-spins" class="col-sm-12 report-container">
</div>


@section Scripts {
    <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
    <script src="~/js/report.min.js" asp-append-version="true"></script>
}