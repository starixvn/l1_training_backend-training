@using GamesAdmin.Core.Enumeration;
@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@model EditViewModel

@if (Model.ApplyMultiplier)
{
    <div class="form-group" id="odds-multipliers">
        <label class="control-label">Multiplier Values</label>
        <label class="icon-add" style="margin-bottom: -10px;" onclick="gameStatus.addMultiplierItem()"></label>
        @Html.EditorFor(x => x.OddsMultipliers.Values)
    </div>

    <div class="form-group">
        <label asp-for="MaxWinPerRound" class="control-label max-win-per-round-label">Max Win Per Round</label>
        <input asp-for="MaxWinPerRound" type="number" class="form-control max-win-per-round" />
        <label> x Max Bet</label>
    </div>
}