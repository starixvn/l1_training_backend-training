@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@using GamesAdmin.Site.Extensions;

@model MarginSettingViewModel;
<div class="form-group row">
    <div class="col-lg-12 mb-3">
        <fieldset class="odds-range">
            <legend class="range-order">Odds Range</legend>
            <div class="form-group row">
                <div class="col-lg-6">
                    <label class="control-label">Max value</label>
                    <input type="number" value="@Model.MarginSetting["max"]" class="form-control" name="max" />
                </div>
            </div>
            <div class="mb-3"><b>Margin per bet choice</b></div>
            <div class="form-group row">
                @foreach (var (key, value) in Model.MarginSetting)
                {
                    @if (key != "max")
                    {
                        <div class="col-lg-6">
                            <label class="control-label">@key.ToTitleCase()</label>
                            <input type="number" value="@value" class="form-control mb-3" name="@key" />
                        </div>
                    }
                }
            </div>
        </fieldset>
    </div>
</div>