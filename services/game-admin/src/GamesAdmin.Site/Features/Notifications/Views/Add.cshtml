@using GamesAdmin.Site.Features.Notifications.ViewModels;
@model AddViewModel;

@{
    ViewData["Title"] = "Add Notification";
}
@section Styles {
    <link href="~/css/notification.min.css" rel="stylesheet" asp-append-version="true" />
}

<div class="col-md-10 col-lg-6 card">
    <form class="card-body form" asp-action="Add" asp-controller="Notification" method="post">
        <div class="form-group">
            <label class="control-label">Display As</label>
            <select class="form-control" asp-for="DisplayKindValue" asp-items="Model.DisplayKinds"></select>
        </div>
        <div class="form-group">
            <label class="control-label">Message (VN)</label>
            <textarea class="form-control" rows="4" asp-for="VNMessage"> </textarea>
            <span asp-validation-for="VNMessage" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label class="control-label">Message (EN)</label>
            <textarea class="form-control" rows="4" asp-for="ENMessage"> </textarea>
            <span asp-validation-for="ENMessage" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label class="control-label">Message (CN)</label>
            <textarea class="form-control" rows="4" asp-for="CNMessage"> </textarea>
            <span asp-validation-for="CNMessage" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label class="control-label">Message (TW)</label>
            <textarea class="form-control" rows="4" asp-for="TWMessage"> </textarea>
            <span asp-validation-for="TWMessage" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label class="control-label">Message (TH)</label>
            <textarea class="form-control" rows="4" asp-for="THMessage"> </textarea>
            <span asp-validation-for="THMessage" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label class="control-label">Message (IN)</label>
            <textarea class="form-control" rows="4" asp-for="IDMessage"> </textarea>
            <span asp-validation-for="IDMessage" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label class="control-label">Message (JA)</label>
            <textarea class="form-control" rows="4" asp-for="JAMessage"> </textarea>
            <span asp-validation-for="JAMessage" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label class="control-label">Message (ES)</label>
            <textarea class="form-control" rows="4" asp-for="ESMessage"> </textarea>
            <span asp-validation-for="ESMessage" class="text-danger"></span>
        </div>
        <div class="form-group">
            <a asp-action="Index" asp-controller="Notification" class="btn-gray back-button">
                <i class="icon-back"></i>
                Back
            </a>
            <input type="submit" value="Submit" class="btn-submit" />
        </div>
    </form>
</div>

