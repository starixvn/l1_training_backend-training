@using GamesAdmin.Site.Features.Report.ViewModels;
@using GamesAdmin.Core.Enumeration;
@model SlotGameReportViewModel
@{
    ViewData["Title"] = Model.GameDisplayName;
}

@section Styles {
    <link href="~/css/slot-game-report.min.css" rel="stylesheet" asp-append-version="true" />
}
    @if(Model.IsEnabledJackpot)
    {
        
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#normal" role="tab" aria-controls="normal" aria-selected="true">Normal Tickets</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#jackpot" role="tab" aria-controls="profile" aria-selected="false">Jackpot tickets</a>
        </li>
    </ul>
    }
<div class="tab-content" id="myTabContent">
    <div class="tab-pane fade show active" id="normal" role="tabpanel" aria-labelledby="home-tab">
        <form class="form filter" data-ajax="true" data-ajax-method="GET"
              asp-action="GetSlotGameReport"
              data-ajax-mode="replace"
              data-ajax-update="#report-result"
              data-ajax-loading="#spinner"
              data-ajax-success="slotGameReportController.initResult()"
              method="get">
            <div class="form-row align-items-center">
                <div class="col-auto">
                    <label class="required" asp-for="PartnerId">Operator</label>
                    <select asp-items="@Model.Selections.Partners" asp-for="PartnerId" class="form-control">
                        <option selected="selected" value="">All</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label asp-for="FromDate" class="control-label">From Date</label>
                    <input type="date" class="form-control" asp-for="FromDate">
                </div>
                <div class="col-auto">
                    <label asp-for="ToDate" class="control-label">To Date</label>
                    <input type="date" class="form-control" asp-for="ToDate">
                </div>
                <div class="col-auto">
                    <label asp-for="RoundId" class="control-label"></label>
                    <input type="number" class="form-control" asp-for="RoundId">
                </div>
                <div class="col-auto">
                    <label asp-for="Nickname" class="control-label"></label>
                    <input type="text" class="form-control" placeholder="Nickname" asp-for="Nickname">
                </div>
                <div class="col-auto">
                    <label asp-for="Username" class="control-label"></label>
                    <input type="text" class="form-control" placeholder="Username" asp-for="Username">
                </div>
                <div class="col-auto mt-5">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="ConvertToUSD">
                        <label class="form-check-label" asp-for="ConvertToUSD">
                            Convert to @Model.BaseCurrency
                        </label>
                    </div>
                </div>
                <div class="col-auto mt-5">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="ExcludeUUS">
                        <label class="form-check-label" asp-for="ExcludeUUS">
                        </label>
                    </div>
                </div>
                <input type="hidden" class="form-control" asp-for="Game" value=@Model.GameConfigName>
                <div class="col-auto mt-5">
                    <button type="submit" class="btn-submit">Submit</button>
                    <div id="spinner" class="spinner-border" style="display: none">
                        <span class="sr-only">Loading...</span>
                    </div>
                </div>
            </div>
            <span asp-validation-for="RoundId" class="text-danger"></span>
        </form>

        <div id="card-container" class="card-container card display-none">
            <div id="report-result" class="col-sm-12 report-container card-body">
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="jackpot" role="tabpanel" aria-labelledby="jackpot-tab">
        <partial name="Jackpot" model="new JackpotReportViewModel() { GameId = (int) Model.GameId, BaseCurrency = Model.BaseCurrency, EnableConvertBase = ((int)GameId.FourGuardians != (int) Model.GameId) }" />
    </div>
</div>

<div class="modal fade" id="modal" tabindex="-1" role="dialog" aria-labelledby="modal" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bet History</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.min.js"></script>
    <script type="text/javascript" src="~/lib/data-tables/datatables.js"></script>
    <script type="text/javascript" src="~/js/slot-game-report.js" asp-append-version="true"></script>
}