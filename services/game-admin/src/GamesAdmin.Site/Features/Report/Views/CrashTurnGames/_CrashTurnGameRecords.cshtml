@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model CrashTurnGameReportResultViewModel

<div class="row row-table">
    <div class="col-sm-12">
        <table id="tbl-crash-turn-game" class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th rowspan="2" class="col-date">Date (GMT+7)</th>
                    <th rowspan="2">Operator</th>
                    <th rowspan="2">Username</th>
                    <th rowspan="2" class="col-nickname">Nickname</th>
                    <th rowspan="2">Currency</th>
                    <th rowspan="2">Round ID</th>
                    <th rowspan="2">Result(Crash Point)</th>
                    <th colspan="3" class="col-number">Cashout</th>
                </tr>
                <tr>
                    <th>Multiplier</th>
                    <th>Bet</th>
                    <th>Win</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bet in Model.Records)
                {
                    <tr>
                        <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td class="text-center">@bet.Partner</td>
                        <td class="text-center">@bet.Username</td>
                        <td class="text-center">
                            @bet.Nickname
                        </td>
                        <td class="text-center">@bet.Currency</td>
                        <td class="text-center">@bet.RoundId</td>
                        <td class="text-center">@bet.Result</td>
                        @if(bet.HasCashOut)
                        {                           
                            <td class="text-center">@bet.CashOutBetLog.DisplayMultiplier</td>
                            <td class="text-center">@HtmlHelpers.formatNumber(bet.CashOutBetLog.Amount)</td>
                            <td class="text-center">@HtmlHelpers.formatNumber(bet.CashOutBetLog.WinAmount)</td>
                        }
                        else
                        {
                            <td class="text-center">-</td>
                            <td class="text-center">-</td>
                            <td class="text-center">-</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>