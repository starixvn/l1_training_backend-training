@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model VipFishPrawnCrabReportResultViewModel

<div class="row row-table">
    <div class="col-sm-12">
        @if (Model.RoundResult.Number != 0)
        {
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Round ID</th>
                        <th>Exchange ID</th>
                        <th>Results</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">@Model.RoundResult.Number</td>
                        <td class="text-center">@Model.RoundResult.ExchangeRateId</td>
                        <td class="text-center">
                            @foreach (var dice in Model.RoundResult.Result)
                            {
                                <img class="vip-animal" src="~/images/vip_animal_@(dice).png" />
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        }
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th rowspan="2" class="col-date">Date (GMT+7)</th>
                    <th rowspan="2">Operator</th>
                    <th rowspan="2">Username</th>
                    <th rowspan="2" class="col-nickname">Nickname</th>
                    <th rowspan="2">Currency</th>
                    <th colspan="9" class="col-number">Stake</th>
                    <th rowspan="2" class="col-number">Win</th>
                </tr>

                <tr>
                    <th>Stag</th>
                    <th>Gourd</th>
                    <th>Rooster</th>
                    <th>Fish</th>
                    <th>Crab</th>
                    <th>Prawn</th>
                    <th>Any Triple</th>
                    <th>Mountain</th>
                    <th>Ocean</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bet in Model.Records)
                {
                    <tr>
                        <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td class="text-center">@bet.Partner</td>
                        <td>@bet.Username</td>
                        <td>
                            @bet.Nickname
                        </td>
                        <td class="text-center">@bet.Currency</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Stag) / Model.BaseCurrencyMultiplier : bet.Stag)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Gourd) / Model.BaseCurrencyMultiplier : bet.Gourd)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Rooster) / Model.BaseCurrencyMultiplier : bet.Rooster)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Fish) / Model.BaseCurrencyMultiplier : bet.Fish)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Crab) / Model.BaseCurrencyMultiplier : bet.Crab)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Prawn) / Model.BaseCurrencyMultiplier : bet.Prawn)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.AnyTriple) / Model.BaseCurrencyMultiplier : bet.AnyTriple)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Mountain) / Model.BaseCurrencyMultiplier : bet.Mountain)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Ocean) / Model.BaseCurrencyMultiplier : bet.Ocean)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.BaseBetWin / Model.BaseCurrencyMultiplier : bet.BetWin)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @if (Model.Records.Count() == 0)
                {
                    <tr>
                        <td class="text-center" colspan="18">No data</td>
                    </tr>
                }
                else if (Model.ConvertToUSD)
                {
                    <tr class="total">
                        <td>Total in @Model.BaseCurrency</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Stag)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Gourd)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Rooster)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Fish)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Crab)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Prawn)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.AnyTriple)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Mountain)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Ocean)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.BaseBetWin) / Model.BaseCurrencyMultiplier)</td>
                    </tr>
                }
            </tfoot>
        </table>
    </div>
</div>