@using GamesAdmin.Core
@using GamesAdmin.Core.Enumeration.BetChoices
@using GamesAdmin.Site.Features.Report.ViewModels
@model HiLoBetHistoryViewModel

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Date (GMT+7)</th>
            <th>Round</th>
            <th>Turn</th>
            <th>Bet Choice</th>
            <th>Base Card</th>
            <th>Result Card</th>
            <th>Stake</th>
            <th>Win</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                @Model.RoundResult.Time.ToString(Constants.DateTimeFormat)
            </td>
            <td rowspan="@(Model.Bets.Count() + 2)" class="text-center">
                @Model.RoundResult.Number
            </td>
            <td colspan="4" class="text-center">Start Round</td>
            <td class="bold text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? Model.RoundResult.BaseAmount / Model.BaseCurrencyMultiplier : Model.RoundResult.Amount)</td>
            <td></td>
        </tr>
        @foreach (var bet in Model.Bets)
        {
            <tr>
                <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                <td class="text-center">
                    @bet.Order
                </td>
                <td class="text-center">
                    @(HiLoBetChoice.FromValue<HiLoBetChoice>(bet.Choice).DisplayName)
                </td>
                @foreach (var card in bet.Cards)
                {
                    <td class="hilo-result">
                        <div class="cards">
                            <div class="card card-type-@card.Suit">
                                <span>@card.Rank</span>
                                <img class="img" src="~/images/card_@(card.Suit).png" />
                            </div>
                        </div>
                    </td>
                }
                <td class="text-right bold">
                    @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amount) / Model.BaseCurrencyMultiplier : bet.Amount)
                </td>
                <td class="text-right bold">
                    @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Betwin) / Model.BaseCurrencyMultiplier : bet.Betwin)
                </td>
            </tr>
        }
        <tr>
            <td>
                @Model.RoundResult.EndTime?.ToString(Constants.DateTimeFormat)
            </td>
            <td colspan="4" class="text-center">End Round</td>
            <td></td>
            <td class="bold text-right">
                @if (Model.RoundResult.Paid)
                {
                    @(HtmlHelpers.formatNumber(Model.ConvertToUSD ? Model.RoundResult.BaseBetwin / Model.BaseCurrencyMultiplier : Model.RoundResult.Betwin))
                }
                else
                {
                    @("Running")
                }
            </td>
        </tr>
    </tbody>
</table>