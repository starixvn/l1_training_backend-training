@using GamesAdmin.Site.Features.Report.ViewModels;
@using GamesAdmin.Core.Enumeration.BetChoices;
@using GamesAdmin.Site.Extensions
@using GamesAdmin.Core

@model KenoReportViewModel

<div class="row row-table">
    <div class="col-sm-12">
        @if (Model.RoundResult.Results != null)
        {
            <table class="table table-bordered table-hover stripe tble-vietlot">
                <thead>
                    <tr>
                        <th>Round ID / Date (GMT+7)</th>
                        <th>Exchange ID</th>
                        <th>Result</th>
                        <th>Total Points</th>
                        <th>Big / Small</th>
                        <th>Even / Odd</th>
                        <th>5 Elements</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">
                            @Model.RoundId.ToString("D7")
                            <div>@Model.RoundResult.Time?.ToReportDateTimeFormat(Model.TimeZoneInfo)</div>
                        </td>
                        <td class="text-center">@Model.RoundResult.ExchangeRateId</td>
                        <td>
                            <div class="list-numbers">
                                @foreach (var number in Model.RoundResult.Results)
                                {
                                    <span class="number">
                                        @number
                                    </span>
                                }
                            </div>
                        </td>
                        <td class="text-center">@Model.RoundResult.Total</td>
                        <td class="text-center">@Model.RoundResult.BigSmallResult</td>
                        <td class="text-center">@Model.RoundResult.OddEvenResult</td>
                        <td class="text-center">@Model.RoundResult.FiveElementsResult</td>
                    </tr>
                </tbody>
            </table>
        }
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th class="col-date">Date (GMT+7)</th>
                    <th>Operator</th>
                    <th>Username</th>
                    <th>Nickname</th>
                    <th>Currency</th>
                    <th>@KenoBetChoice.Big.DisplayName</th>
                    <th>@KenoBetChoice.Small.DisplayName</th>
                    <th>@KenoBetChoice.Even.DisplayName</th>
                    <th>@KenoBetChoice.Odd.DisplayName</th>
                    <th>@KenoBetChoice.Gold.DisplayName</th>
                    <th>@KenoBetChoice.Wood.DisplayName</th>
                    <th>@KenoBetChoice.Water.DisplayName</th>
                    <th>@KenoBetChoice.Fire.DisplayName</th>
                    <th>@KenoBetChoice.Earth.DisplayName</th>
                    <th class="col-number">Win</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bet in Model.BetTickets)
                {

                    <tr>
                        <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td class="text-center">@bet.Partner</td>
                        <td>@bet.Username</td>
                        <td>
                            <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                               asp-action="KenoBetHistory"
                               asp-route-game="@Model.Game"
                               asp-route-roundId="@Model.RoundId"
                               asp-route-userId="@bet.UserId"
                               asp-route-partnerId="@bet.PartnerId"
                               asp-route-convertToUSD="@Model.ConvertToUSD">
                                @bet.Nickname
                            </a>
                        </td>
                        <td class="text-center">@bet.Currency</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amounts[@KenoBetChoice.Big.Value]) / Model.BaseCurrencyMultiplier : bet.Amounts[@KenoBetChoice.Big.Value])</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amounts[@KenoBetChoice.Small.Value]) / Model.BaseCurrencyMultiplier : bet.Amounts[@KenoBetChoice.Small.Value])</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amounts[@KenoBetChoice.Even.Value]) / Model.BaseCurrencyMultiplier : bet.Amounts[@KenoBetChoice.Even.Value])</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amounts[@KenoBetChoice.Odd.Value]) / Model.BaseCurrencyMultiplier : bet.Amounts[@KenoBetChoice.Odd.Value])</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amounts[@KenoBetChoice.Gold.Value]) / Model.BaseCurrencyMultiplier : bet.Amounts[@KenoBetChoice.Gold.Value])</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amounts[@KenoBetChoice.Wood.Value]) / Model.BaseCurrencyMultiplier : bet.Amounts[@KenoBetChoice.Wood.Value])</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amounts[@KenoBetChoice.Water.Value]) / Model.BaseCurrencyMultiplier : bet.Amounts[@KenoBetChoice.Water.Value])</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amounts[@KenoBetChoice.Fire.Value]) / Model.BaseCurrencyMultiplier : bet.Amounts[@KenoBetChoice.Fire.Value])</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amounts[@KenoBetChoice.Earth.Value]) / Model.BaseCurrencyMultiplier : bet.Amounts[@KenoBetChoice.Earth.Value])</td>
                        <td class="text-right">@(Model.RoundResult.Results == null ? "Running" : HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.BaseBetWin / Model.BaseCurrencyMultiplier : bet.BetWin)) </td>
                    </tr>

                }
            </tbody>
            <tfoot>
                @if (Model.Total == 0)
                {
                    <tr>
                        <td class="text-center" colspan="15">No data</td>
                    </tr>
                }
                else if (Model.ConvertToUSD)
                {
                    <tr class="total">
                        <td colspan="5">Total in @Model.BaseCurrency</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.BetTickets.Sum(x => x.ConvertToBase(x.Amounts[@KenoBetChoice.Big.Value]) / Model.BaseCurrencyMultiplier))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.BetTickets.Sum(x => x.ConvertToBase(x.Amounts[@KenoBetChoice.Small.Value]) / Model.BaseCurrencyMultiplier))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.BetTickets.Sum(x => x.ConvertToBase(x.Amounts[@KenoBetChoice.Even.Value]) / Model.BaseCurrencyMultiplier))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.BetTickets.Sum(x => x.ConvertToBase(x.Amounts[@KenoBetChoice.Odd.Value]) / Model.BaseCurrencyMultiplier))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.BetTickets.Sum(x => x.ConvertToBase(x.Amounts[@KenoBetChoice.Gold.Value]) / Model.BaseCurrencyMultiplier))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.BetTickets.Sum(x => x.ConvertToBase(x.Amounts[@KenoBetChoice.Wood.Value]) / Model.BaseCurrencyMultiplier))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.BetTickets.Sum(x => x.ConvertToBase(x.Amounts[@KenoBetChoice.Water.Value]) / Model.BaseCurrencyMultiplier))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.BetTickets.Sum(x => x.ConvertToBase(x.Amounts[@KenoBetChoice.Fire.Value]) / Model.BaseCurrencyMultiplier))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.BetTickets.Sum(x => x.ConvertToBase(x.Amounts[@KenoBetChoice.Earth.Value]) / Model.BaseCurrencyMultiplier))</td>
                        <td class="text-right">@(Model.RoundResult.Results == null ? "Running" : HtmlHelpers.formatNumber(Model.BetTickets.Sum(x => x.BaseBetWin) / Model.BaseCurrencyMultiplier))</td>
                    </tr>
                }
            </tfoot>
        </table>
    </div>
</div>