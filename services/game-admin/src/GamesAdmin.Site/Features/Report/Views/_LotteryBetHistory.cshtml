@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels
@model LotteryBetHistoryViewModel

@{
    var settlementResult = Model.RoundResult.SettlementResult;
}

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Prizes</th>
            <th colspan="12">RNG Lottery #@Model.RoundResult.Number</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="text-center">Special</td>
            <td colSpan="12" class="text-center text-danger">
                @Model.RoundResult.Special.FirstOrDefault()
            </td>
        </tr>
        <tr>
            <td class="text-center">First</td>
            <td colSpan="12" class="text-center">
                @Model.RoundResult.First.FirstOrDefault()
            </td>
        </tr>
        <tr>
            <td class="text-center">Second</td>
            @foreach (var number in Model.RoundResult.Second)
            {
                <td colSpan="6" class="text-center">
                    @number
                </td>
            }
        </tr>
        <tr>
            <td class="text-center" rowSpan="2">Third</td>
            @foreach (var number in Model.RoundResult.Third.ToList().GetRange(0, 3))
            {
                <td colSpan="4" class="text-center">
                    @number
                </td>
            }
        </tr>
        <tr>
            @foreach (var number in Model.RoundResult.Third.ToList().GetRange(3, 3))
            {
                <td colSpan="4" class="text-center">
                    @number
                </td>
            }
        </tr>
        <tr>
            <td class="text-center">Fourth</td>
            @foreach (var number in Model.RoundResult.Fourth)
            {
                <td colSpan="3" class="text-center">
                    @number
                </td>
            }
        </tr>
        <tr>
            <td class="text-center" rowSpan="2">Fifth</td>
            @foreach (var number in Model.RoundResult.Fifth.ToList().GetRange(0, 3))
            {
                <td colSpan="4" class="text-center">
                    @number
                </td>
            }
        </tr>
        <tr>
            @foreach (var number in Model.RoundResult.Fifth.ToList().GetRange(3, 3))
            {
                <td colSpan="4" class="text-center">
                    @number
                </td>
            }
        </tr>
        <tr>
            <td class="text-center">Sixth</td>
            @foreach (var number in Model.RoundResult.Sixth)
            {
                <td colSpan="4" class="text-center">
                    @number
                </td>
            }
        </tr>
        <tr>
            <td class="text-center">Seventh</td>
            @foreach (var number in Model.RoundResult.Seventh)
            {
                <td colSpan="3" class="text-center text-danger">
                    @number
                </td>
            }
        </tr>
    </tbody>
</table>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Date (GMT+7)</th>
            <th>Nickname</th>
            <th>Bet Type</th>
            <th>Bet Choices</th>
            <th>Odds</th>
            <th>Bet Amount</th>
            <th>Win</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bet in Model.Bets)
        {
            var renderGroupInfo = true;

            foreach (var betChoice in bet.Choices.FourSets)
            {
                var rowSpan = bet.Choices.FourSets.Count();
                <tr>
                    @if (renderGroupInfo)
                    {
                        renderGroupInfo = false;
                        <td rowspan="@rowSpan">@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td rowspan="@rowSpan" class="text-center">
                            @bet.Name
                        </td>
                        <td rowspan="@rowSpan" class="text-center">
                            4 Sets
                        </td>
                    }
                    <td class="text-center">
                        @betChoice.Key
                    </td>
                    <td class="text-center">
                        @(Model.FractionalOddsFormat ? Model.Odds.FourSets - 1 : Model.Odds.FourSets)
                        @{
                            byte occurence = settlementResult.Occurrences.Seventh.ContainsKey(betChoice.Key) ? settlementResult.Occurrences.Seventh[betChoice.Key] : (byte)0;
                            if (occurence > 1)
                            {
                                @("(")<span class="text-danger">@($"x{occurence}")</span>@(")")
                            }
                        }
                    </td>

                    <td class="text-right">
                        @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value)
                    </td>
                    <td class="text-right">
                        @HtmlHelpers.formatNumber((Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value) * Model.Odds.FourSets * occurence)
                    </td>
                </tr>
            }

            foreach (var betChoice in bet.Choices.Special)
            {
                var rowSpan = bet.Choices.Special.Count();
                <tr>
                    @if (renderGroupInfo)
                    {
                        renderGroupInfo = false;
                        <td rowspan="@rowSpan">@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td rowspan="@rowSpan" class="text-center">
                            @bet.Name
                        </td>
                        <td rowspan="@rowSpan" class="text-center">
                            Special
                        </td>
                    }
                    <td class="text-center">
                        @betChoice.Key
                    </td>
                    <td class="text-center">
                        @(Model.FractionalOddsFormat ? Model.Odds.Special - 1 : Model.Odds.Special)
                    </td>
                    <td class="text-right">
                        @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value)
                    </td>
                    <td class="text-right">
                        @if (settlementResult.Special == betChoice.Key)
                        {
                            @HtmlHelpers.formatNumber((Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value) * Model.Odds.Special)
                        }
                        else
                        {
                            @(0)
                        }
                    </td>
                </tr>
            }

            foreach (var betChoice in bet.Choices.Head)
            {
                var rowSpan = bet.Choices.Head.Count();
                <tr>
                    @if (renderGroupInfo)
                    {
                        renderGroupInfo = false;
                        <td rowspan="@rowSpan">@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td rowspan="@rowSpan" class="text-center">
                            @bet.Name
                        </td>
                        <td rowspan="@rowSpan" class="text-center">
                            Head
                        </td>
                    }
                    <td class="text-center">
                        @betChoice.Key
                    </td>
                    <td class="text-center">
                        @(Model.FractionalOddsFormat ? Model.Odds.Head - 1 : Model.Odds.Head)
                    </td>
                    <td class="text-right">
                        @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value)
                    </td>
                    <td class="text-right">
                        @if (settlementResult.Head == betChoice.Key)
                        {
                            @HtmlHelpers.formatNumber((Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value) * Model.Odds.Head)
                        }
                        else
                        {
                            @(0)
                        }
                    </td>
                </tr>
            }

            foreach (var betChoice in bet.Choices.Tail)
            {
                var rowSpan = bet.Choices.Tail.Count();
                <tr>
                    @if (renderGroupInfo)
                    {
                        renderGroupInfo = false;
                        <td rowspan="@rowSpan">@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td rowspan="@rowSpan" class="text-center">
                            @bet.Name
                        </td>
                        <td rowspan="@rowSpan" class="text-center">
                            Tail
                        </td>
                    }

                    <td class="text-center">
                        @betChoice.Key
                    </td>
                    <td class="text-center">
                        @(Model.FractionalOddsFormat ? Model.Odds.Tail - 1 : Model.Odds.Tail)
                    </td>
                    <td class="text-right">
                        @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value)
                    </td>
                    <td class="text-right">
                        @if (settlementResult.Tail == betChoice.Key)
                        {
                            @HtmlHelpers.formatNumber((Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value) * Model.Odds.Tail)
                        }
                        else
                        {
                            @(0)
                        }
                    </td>
                </tr>
            }

            foreach (var betChoice in bet.Choices.TwentySevenSets)
            {
                var rowSpan = bet.Choices.TwentySevenSets.Count();
                <tr>
                    @if (renderGroupInfo)
                    {
                        renderGroupInfo = false;
                        <td rowspan="@rowSpan">@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td rowspan="@rowSpan" class="text-center">
                            @bet.Name
                        </td>
                        <td rowspan="@rowSpan" class="text-center">
                            27 Sets
                        </td>
                    }
                    <td class="text-center">
                        @betChoice.Key
                    </td>
                    <td class="text-center">
                        @(Model.FractionalOddsFormat ? Model.Odds.TwentySevenSets - 1 : Model.Odds.TwentySevenSets)
                        @{
                            byte occurence = settlementResult.Occurrences.All.ContainsKey(betChoice.Key) ? settlementResult.Occurrences.All[betChoice.Key] : (byte)0;
                            if (occurence > 1)
                            {
                                @("(")<span class="text-danger">@($"x{occurence}")</span>@(")")
                            }
                        }
                    </td>

                    <td class="text-right">
                        @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value)
                    </td>
                    <td class="text-right">
                        @HtmlHelpers.formatNumber((Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value) * Model.Odds.TwentySevenSets * occurence)
                    </td>
                </tr>
            }

            foreach (var betChoice in bet.Choices.Parlay2)
            {
                var rowSpan = bet.Choices.Parlay2.Count();
                <tr>
                    @if (renderGroupInfo)
                    {
                        renderGroupInfo = false;
                        <td rowspan="@rowSpan">@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td rowspan="@rowSpan" class="text-center">
                            @bet.Name
                        </td>
                        <td rowspan="@rowSpan" class="text-center">
                            Parlay 2
                        </td>
                    }

                    <td class="text-center">
                        @betChoice.Key.Replace("-", ", ")
                    </td>
                    <td class="text-center">
                        @(Model.FractionalOddsFormat ? Model.Odds.Parlay2 - 1 : Model.Odds.Parlay2)
                    </td>
                    <td class="text-right">
                        @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value)
                    </td>
                    <td class="text-right">
                        @if (betChoice.Key.Split("-").All(number => settlementResult.TwentySevenSets.Contains(number)))
                        {
                            @HtmlHelpers.formatNumber((Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value) * Model.Odds.Parlay2)
                        }
                        else
                        {
                            @(0)
                        }
                    </td>
                </tr>
            }

            foreach (var betChoice in bet.Choices.Parlay3)
            {
                var rowSpan = bet.Choices.Parlay3.Count();
                <tr>
                    @if (renderGroupInfo)
                    {
                        renderGroupInfo = false;
                        <td rowspan="@rowSpan">@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td rowspan="@rowSpan" class="text-center">
                            @bet.Name
                        </td>
                        <td rowspan="@rowSpan" class="text-center">
                            Parlay 3
                        </td>
                    }

                    <td class="text-center">
                        @betChoice.Key.Replace("-", ", ")
                    </td>
                    <td class="text-center">
                        @(Model.FractionalOddsFormat ? Model.Odds.Parlay3 - 1 : Model.Odds.Parlay3)
                    </td>
                    <td class="text-right">
                        @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value)
                    </td>
                    <td class="text-right">
                        @if (betChoice.Key.Split("-").All(number => settlementResult.TwentySevenSets.Contains(number)))
                        {
                            @HtmlHelpers.formatNumber((Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value) * Model.Odds.Parlay3)
                        }
                        else
                        {
                            @(0)
                        }
                    </td>
                </tr>
            }

            foreach (var betChoice in bet.Choices.Parlay4)
            {
                var rowSpan = bet.Choices.Parlay4.Count();
                <tr>
                    @if (renderGroupInfo)
                    {
                        renderGroupInfo = false;
                        <td rowspan="@rowSpan">@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td rowspan="@rowSpan" class="text-center">
                            @bet.Name
                        </td>
                        <td rowspan="@rowSpan" class="text-center">
                            Parlay 3
                        </td>
                    }

                    <td class="text-center">
                        @betChoice.Key.Replace("-", ", ")
                    </td>
                    <td class="text-center">
                        @(Model.FractionalOddsFormat ? Model.Odds.Parlay4 - 1 : Model.Odds.Parlay4)
                    </td>
                    <td class="text-right">
                        @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value)
                    </td>
                    <td class="text-right">
                        @if (betChoice.Key.Split("-").All(number => settlementResult.TwentySevenSets.Contains(number)))
                        {
                            @HtmlHelpers.formatNumber((Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value) * Model.Odds.Parlay4)
                        }
                        else
                        {
                            @(0)
                        }
                    </td>
                </tr>
            }

            foreach (var betChoice in bet.Choices.Others)
            {
                var rowSpan = bet.Choices.Others.Count();
                <tr>
                    @if (renderGroupInfo)
                    {
                        renderGroupInfo = false;
                        <td rowspan="@rowSpan">@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td rowspan="@rowSpan" class="text-center">
                            @bet.Name
                        </td>
                        <td rowspan="@rowSpan" class="text-center">
                            Others
                        </td>
                    }
                    <td class="text-center text-capitalize">
                        @betChoice.Key
                    </td>
                    <td class="text-center">
                        @(Model.FractionalOddsFormat ? Model.Odds.Others - 1 : Model.Odds.Others)
                    </td>
                    <td class="text-right">
                        @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value)
                    </td>
                    <td class="text-right">
                        @if (settlementResult.Others[betChoice.Key])
                        {
                            @HtmlHelpers.formatNumber((Model.ConvertToUSD ? bet.ConvertToBase(betChoice.Value) / Model.BaseCurrencyMultiplier : betChoice.Value) * Model.Odds.Others)
                        }
                        else
                        {
                            @(0)
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>