@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model BitcoinMasterReportResultViewModel
@{
    var upCount = Model.UpRecords.Count;
    var downCount = Model.DownRecords.Count;
    var oddCount = Model.OddRecords.Count;
    var evenCount = Model.EvenRecords.Count;

    var upDownCount = Math.Max(upCount, downCount);
    var oddEvenCount = Math.Max(oddCount, evenCount);
    var round = Model.RoundResult;
}
<div class="row row-table">
    <div class="col-sm-12">
        @if (Model.RoundResult.Number != 0)
        {
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Round ID</th>
                        <th>Exchange ID</th>
                        <th>Betting Price</th>
                        <th>Result</th>
                        <th>Winning Options</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">@Model.RoundResult.Number</td>
                        <td class="text-center">@Model.RoundResult.ExchangeRateId</td>
                        <td class="text-center">@HtmlHelpers.formatNumber2(Model.RoundResult.BettingPrice)</td>
                        <td class="text-center bitcoin-master-result">
                            <span>@HtmlHelpers.formatNumber2(Model.RoundResult.ResultPrice)</span>&nbsp;
                            @if (Model.RoundResult.IsUp)
                            {
                                <span class="up">(<img src="~/images/up.png" /><span class="result-detail">@HtmlHelpers.formatNumber2(Model.RoundResult.PriceDiff)</span>)</span>
                            }
                            else if (Model.RoundResult.IsDown)
                            {
                                <span class="down">(<img src="~/images/down.png" /><span class="result-detail">@HtmlHelpers.formatNumber2(Model.RoundResult.PriceDiff)</span>)</span>
                            }
                            else
                            {
                                <span class="tie">(<span class="result-detail">@HtmlHelpers.formatNumber2(Model.RoundResult.PriceDiff)</span>)</span>
                            }
                        </td>
                        <td class="text-center">@Model.WinningOptions</td>
                    </tr>
                </tbody>
            </table>
        }

        <div class="div-bet-choices">
            <div id="spn-bet-choice-updown" class="spn-bet-choice spn-bet-choice-updown selected" onclick="bitcoinMasterReport.showUpDownTable()">Up/Down</div>
            <div id="spn-bet-choice-oddeven" class="spn-bet-choice spn-bet-choice-oddeven" onclick="bitcoinMasterReport.showOddEvenTable()">Odd/Even</div>
        </div>
        <table class="table table-bordered table-hover table-updown">
            <thead>
                <tr>
                    <th colspan="8" class="title">UP</th>
                    <th colspan="8" class="title">DOWN</th>
                </tr>
                <tr>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-partner">Operator</th>
                    <th>Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-currency">Currency</th>
                    <th class="col-number">Stake</th>
                    <th class="col-number">Refund</th>
                    <th class="col-number">Win</th>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-partner">Operator</th>
                    <th>Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-currency">Currency</th>
                    <th class="col-number">Stake</th>
                    <th class="col-number">Refund</th>
                    <th class="col-number">Win</th>
                </tr>
            </thead>
            @if (upDownCount == 0)
            {
                <tfoot>
                    <tr>
                        <td class="text-center" colspan="16">No data</td>
                    </tr>
                </tfoot>
            }
            else
            {
                <tbody>
                    @for (var i = 0; i < upDownCount; i++)
                    {
                        var upRecord = i < upCount ? Model.UpRecords[i] : null;
                        var downRecord = i < downCount ? Model.DownRecords[i] : null;

                        <tr>
                            @if (upRecord == null)
                            {
                                <td class="text-center"></td>
                                <td class="text-left"></td>
                                <td class="text-left"></td>
                                <td class="text-left"></td>
                                <td class="text-left"></td>
                                <td class="text-right"></td>
                                <td class="text-right"></td>
                                <td class="text-right"></td>
                            }
                            else
                            {
                                <td class="text-center">@upRecord.Time.ToString(Constants.DateTimeFormat)</td>
                                <td class="text-left">@upRecord.Partner</td>
                                <td class="text-left">@upRecord.Username</td>
                                <td class="text-left">
                                    <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                                       asp-action="GetBitcoinMasterBetHistory"
                                       asp-route-roundId="@Model.RoundResult.Number"
                                       asp-route-nickname="@upRecord.Nickname"
                                       asp-route-rate="@Model.RoundResult.ExchangeRate">
                                        @upRecord.Nickname
                                    </a>
                                </td>
                                <td class="text-left">@upRecord.Currency</td>
                                <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(upRecord.Bet))</td>
                                <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(upRecord.Back))</td>
                                <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(upRecord.GrossWin))</td>
                            }

                            @if (downRecord == null)
                            {
                                <td class="text-center"></td>
                                <td class="text-left"></td>
                                <td class="text-left"></td>
                                <td class="text-left"></td>
                                <td class="text-left"></td>
                                <td class="text-right"></td>
                                <td class="text-right"></td>
                                <td class="text-right"></td>
                            }
                            else
                            {
                                <td class="text-center">@downRecord.Time.ToString(Constants.DateTimeFormat)</td>
                                <td class="text-left">@downRecord.Partner</td>
                                <td class="text-left">@downRecord.Username</td>
                                <td class="text-left">
                                    <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                                       asp-action="GetBitcoinMasterBetHistory"
                                       asp-route-roundId="@Model.RoundResult.Number"
                                       asp-route-nickname="@downRecord.Nickname"
                                       asp-route-rate="@Model.RoundResult.ExchangeRate">
                                        @downRecord.Nickname
                                    </a>
                                </td>
                                <td class="text-left">@downRecord.Currency</td>
                                <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(downRecord.Bet))</td>
                                <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(downRecord.Back))</td>
                                <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(downRecord.GrossWin))</td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total">
                        <td colspan="5" class="text-left">Total in @Model.Currency</td>
                        <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(Model.UpTotal.Bet))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(Model.UpTotal.Back))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(Model.UpTotal.BetWin))</td>
                        <td colspan="5" class="text-left">Total in @Model.Currency</td>
                        <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(Model.DownTotal.Bet))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(Model.DownTotal.Back))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(Model.DownTotal.BetWin))</td>
                    </tr>
                </tfoot>
            }
        </table>
        <table class="table table-bordered table-hover table-oddeven display-none">
            <thead>
                <tr>
                    <th colspan="8" class="title">ODD</th>
                    <th colspan="8" class="title">EVEN</th>
                </tr>
                <tr>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-partner">Operator</th>
                    <th>Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-currency">Currency</th>
                    <th class="col-number">Stake</th>
                    <th class="col-number">Refund</th>
                    <th class="col-number">Win</th>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-partner">Operator</th>
                    <th>Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-currency">Currency</th>
                    <th class="col-number">Stake</th>
                    <th class="col-number">Refund</th>
                    <th class="col-number">Win</th>
                </tr>
            </thead>
            @if (oddEvenCount == 0)
            {
                <tfoot>
                    <tr>
                        <td class="text-center" colspan="16">No data</td>
                    </tr>
                </tfoot>
            }
            else
            {
                <tbody>
                    @for (var i = 0; i < oddEvenCount; i++)
                    {
                        var oddRecord = i < oddCount ? Model.OddRecords[i] : null;
                        var evenRecord = i < evenCount ? Model.EvenRecords[i] : null;

                        <tr>
                            @if (oddRecord == null)
                            {
                                <td class="text-center"></td>
                                <td class="text-left"></td>
                                <td class="text-left"></td>
                                <td class="text-left"></td>
                                <td class="text-left"></td>
                                <td class="text-right"></td>
                                <td class="text-right"></td>
                                <td class="text-right"></td>
                            }
                            else
                            {
                                <td class="text-center">@oddRecord.Time.ToString(Constants.DateTimeFormat)</td>
                                <td class="text-left">@oddRecord.Partner</td>
                                <td class="text-left">@oddRecord.Username</td>
                                <td class="text-left">
                                    <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                                       asp-action="GetBitcoinMasterBetHistory"
                                       asp-route-roundId="@Model.RoundResult.Number"
                                       asp-route-nickname="@oddRecord.Nickname"
                                       asp-route-rate="@Model.RoundResult.ExchangeRate">
                                        @oddRecord.Nickname
                                    </a>
                                </td>
                                <td class="text-left">@oddRecord.Currency</td>
                                <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(oddRecord.Bet))</td>
                                <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(oddRecord.Back))</td>
                                <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(oddRecord.GrossWin))</td>
                            }

                            @if (evenRecord == null)
                            {
                                <td class="text-center"></td>
                                <td class="text-left"></td>
                                <td class="text-left"></td>
                                <td class="text-left"></td>
                                <td class="text-left"></td>
                                <td class="text-right"></td>
                                <td class="text-right"></td>
                                <td class="text-right"></td>
                            }
                            else
                            {
                                <td class="text-center">@evenRecord.Time.ToString(Constants.DateTimeFormat)</td>
                                <td class="text-left">@evenRecord.Partner</td>
                                <td class="text-left">@evenRecord.Username</td>
                                <td class="text-left">
                                    <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                                       asp-action="GetBitcoinMasterBetHistory"
                                       asp-route-roundId="@Model.RoundResult.Number"
                                       asp-route-nickname="@evenRecord.Nickname"
                                       asp-route-rate="@Model.RoundResult.ExchangeRate">
                                        @evenRecord.Nickname
                                    </a>
                                </td>
                                <td class="text-left">@evenRecord.Currency</td>
                                <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(evenRecord.Bet))</td>
                                <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(evenRecord.Back))</td>
                                <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(evenRecord.GrossWin))</td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total">
                        <td colspan="5" class="text-left">Total in @Model.Currency</td>
                        <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(Model.OddTotal.Bet))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(Model.OddTotal.Back))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(Model.OddTotal.BetWin))</td>
                        <td colspan="5" class="text-left">Total in @Model.Currency</td>
                        <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(Model.EvenTotal.Bet))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(Model.EvenTotal.Back))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber2(round.ConvertByExchangeRate(Model.EvenTotal.BetWin))</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>