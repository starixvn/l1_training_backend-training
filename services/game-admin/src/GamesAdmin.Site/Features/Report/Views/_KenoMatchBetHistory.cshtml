@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels
@using GamesAdmin.Site.Extensions
@model KenoMatchBetHistoryViewModel

@{
    var betChoiceMapper = new Dictionary<string, string>
{
        { "fhBlue", "Team Blue" },
        { "fhRed", "Team Red" },
        { "fhOver", "Over" },
        { "fhUnder", "Under" },
        { "fhOdd", "Odd" },
        { "fhEven", "Even" },
        { "ftBlue", "Team Blue" },
        { "ftRed", "Team Red" },
        { "ftOver", "Over" },
        { "ftUnder", "Under" },
        { "ftOdd", "Odd" },
        { "ftEven", "Even" },
        { "liveFTBlue", "Team Blue" },
        { "liveFTRed", "Team Red" },
        { "liveFTOver", "Over" },
        { "liveFTUnder", "Under" },
        { "liveFTOdd", "Odd" },
        { "liveFTEven", "Even" },
    };

    var betTypeMapper = new Dictionary<string, string>
{
        { "fhBlue", "First Half Team Blue/Team Red" },
        { "fhRed", "First Half Team Blue/Team Red" },
        { "fhOver", "First Half Over/Under" },
        { "fhUnder", "First Half Over/Under" },
        { "fhOdd", "First Half Odd/Even" },
        { "fhEven", "First Half Odd/Even" },
        { "ftBlue", "Full Time Team Blue/Team Red" },
        { "ftRed", "Full Time Team Blue/Team Red" },
        { "ftOver", "Full Time Over/Under" },
        { "ftUnder", "Full Time Over/Under" },
        { "ftOdd", "Full Time Odd/Even" },
        { "ftEven", "Full Time Odd/Even" },
        { "liveFTBlue", "Full Time Team Blue/Team Red (Live)" },
        { "liveFTRed", "Full Time Team Blue/ Team Red (Live)" },
        { "liveFTOver", "Full Time Over/Under (Live)" },
        { "liveFTUnder", "Full Time Over/Under (Live)" },
        { "liveFTOdd", "Full Time Odd/Even (Live)" },
        { "liveFTEven", "Full Time Odd/Even (Live)" },
    };

    var htSettlementResult = Model.RoundResult.HalfTime.SettlementResult;
    var ftSettlementResult = Model.RoundResult.FullTime.SettlementResult;

    var settlmentResultMapper = new Dictionary<string, bool>
{
        { "fhBlue", htSettlementResult.Blue },
        { "fhRed", htSettlementResult.Red },
        { "fhOver", htSettlementResult.Over},
        { "fhUnder", htSettlementResult.Under },
        { "fhOdd", htSettlementResult.Odd},
        { "fhEven", htSettlementResult.Even },
        { "ftBlue", ftSettlementResult.Blue },
        { "ftRed", ftSettlementResult.Red },
        { "ftOver", ftSettlementResult.Over},
        { "ftUnder", ftSettlementResult.Under },
        { "ftOdd", ftSettlementResult.Odd},
        { "ftEven", ftSettlementResult.Even },
        { "liveFTBlue", ftSettlementResult.Blue },
        { "liveFTRed", ftSettlementResult.Red },
        { "liveFTOver", ftSettlementResult.Over},
        { "liveFTUnder", ftSettlementResult.Under },
        { "liveFTOdd", ftSettlementResult.Odd},
        { "liveFTEven", ftSettlementResult.Even },
    };

    var settlmentResultRefund = new Dictionary<string, KenoMatchPeriodSettlementResultViewModel>
{
        { "fhBlue", htSettlementResult },
        { "fhRed", htSettlementResult },
        { "ftBlue", ftSettlementResult },
        { "ftRed", ftSettlementResult },
        { "liveFTBlue", ftSettlementResult },
        { "liveFTRed", ftSettlementResult },
    };
}

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Date (GMT+7)</th>
            <th>Bet Type</th>
            <th>Bet Choice</th>
            <th>Odds</th>
            <th>Bet Amount</th>
            <th>Refund</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bet in Model.Bets)
        {
            var winCssClass = settlmentResultMapper[bet.Choice] ? "text-primary" : string.Empty;

            <tr>
                <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                <td class="@winCssClass text-center ">
                    @betTypeMapper[bet.Choice]
                </td>
                <td class="@winCssClass text-center">
                    @betChoiceMapper[bet.Choice]
                </td>
                <td class="@winCssClass">@(Model.FractionalOddsFormat ? Model.RoundResult.Odds[bet.Choice] - 1 : Model.RoundResult.Odds[bet.Choice])</td>
                <td class="text-right @winCssClass">
                    @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amount) / Model.BaseCurrencyMultiplier : bet.Amount)
                </td>
                <td class="text-right @winCssClass">
                    @if (settlmentResultRefund.ContainsKey(bet.Choice))
                    {
                        var refund = bet.GetRefund(settlmentResultRefund[bet.Choice]);
                        @HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(refund) / Model.BaseCurrencyMultiplier : refund)
                    }
                    else
                    {
                        @HtmlHelpers.formatNumber(0);
                    }
                </td>
            </tr>

        }
    </tbody>
</table>