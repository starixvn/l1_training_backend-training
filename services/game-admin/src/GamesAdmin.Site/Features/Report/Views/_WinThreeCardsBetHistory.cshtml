@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels
@model WinThreeCardsBetHistoryViewModel

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Time</th>
            <th>Bet Choice</th>
            <th>Odds</th>
            <th>Stake</th>
            <th>Win</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bet in Model.Bets)
        {
            <tr>
                <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                <td>@bet.DisplayChoice</td>
                <td>@HtmlHelpers.formatOdds(Model.Odds[bet.Choice], Model.FractionalOddsFormat)</td>
                <td>@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amount) / Model.BaseCurrencyMultiplier : bet.Amount)</td>
                <td>
                    @if (Model.RoundResult.SettlementResult["tie"])
                    {
                        <span>@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amount) / Model.BaseCurrencyMultiplier : bet.Amount)</span>
                    }
                    else
                    {
                        <span>
                            @(Model.RoundResult.SettlementResult[bet.Choice] ? HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(Model.Odds[bet.Choice] * bet.Amount) / Model.BaseCurrencyMultiplier : Model.Odds[bet.Choice] * bet.Amount) : "0")
                        </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>