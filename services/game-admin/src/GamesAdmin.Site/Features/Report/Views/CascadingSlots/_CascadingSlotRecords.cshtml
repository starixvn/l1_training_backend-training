@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model CascadingSlotReportResultViewModel

<div class="row row-table">
    <div class="col-sm-12">
        <table id="tbl-slot-game" class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-nickname">Operator</th>
                    <th class="col-nickname">Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-currency">Currency</th>
                    <th class="col-number">Round</th>
                    <th class="col-exchange-id">Exchange Id</th>
                    <th class="col-number">Total Stake</th>
                    <th class="col-number">Win</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bet in Model.Records)
                {

                    <tr>
                        <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td>@bet.Partner</td>
                        <td>@bet.Username</td>
                        <td>@bet.Nickname</td>
                        <td>@bet.Currency</td>
                        <td class="text-center">
                            <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                               asp-action="GetCascadingSlotBetHistory"
                               asp-route-roundId="@bet.RoundId"
                               asp-route-nickname="@bet.Nickname"
                               asp-route-game="@bet.Game"
                               asp-route-convertToUSD="@Model.ConvertToUSD">
                                @bet.RoundId
                            </a>
                        </td>
                        <td class="text-center">@bet.ExchangeRateId</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(bet.FreeSpin ? 0 : bet.TotalAmount)</td>
                        <td class="text-right">
                            @if (bet.Paid)
                            {
                                @HtmlHelpers.formatNumber(bet.BetWin)
                            }
                            else
                            {
                                @("Running")
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>