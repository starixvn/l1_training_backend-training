@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model SpecialSeDieReportResultViewModel

@{
    var oddRecords = Model.Records.Where(x => x.Choice == "odd").ToList();
    var evenRecords = Model.Records.Where(x => x.Choice == "even").ToList();
    var totalRow = oddRecords.Count > evenRecords.Count ? oddRecords.Count : evenRecords.Count;
}

<div class="row row-table">
    <div class="col-sm-12">
        @if (Model.RoundResult.Number != 0)
        {
            <table class="table table-bordered  table-hover table-se-die" style="width:100%">
                <thead>
                    <tr>
                        <th>Round ID</th>
                        <th>Exchange ID</th>
                        <th>Results</th>
                        <th>Winning Options</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">@Model.RoundResult.Number</td>
                        <td class="text-center">@Model.RoundResult.ExchangeRateId</td>
                        <td class="text-center">
                            @foreach (var chip in Model.RoundResult.Chips)
                            {
                                if (chip)
                                {
                                    <i class="red-chip"></i>
                                }
                                else
                                {
                                    <i class="white-chip"></i>
                                }
                            }
                        </td>
                        <td class="text-center">
                            @(Model.RoundResult.Even ? "Even" : "Odd")
                        </td>
                    </tr>
                </tbody>
            </table>
        }
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th colspan="8" class="big-small-title">Even</th>
                    <th class="line-cell"></th>
                    <th colspan="8" class="big-small-title">Odd</th>
                </tr>
                <tr>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-partner">Operator</th>
                    <th>Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-currency">Currency</th>
                    <th class="col-number">Stake</th>
                    <th class="col-number">Refund</th>
                    <th class="col-number">Win</th>
                    <th class="line-cell"></th>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-partner">Operator</th>
                    <th>Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-currency">Currency</th>
                    <th class="col-number">Stake</th>
                    <th class="col-number">Refund</th>
                    <th class="col-number">Win</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < totalRow; i++)
                {
                    var evenRecord = evenRecords.ElementAtOrDefault(i);
                    var oddRecord = oddRecords.ElementAtOrDefault(i);
                    <tr>
                        <td>@evenRecord?.Time.ToString(Constants.DateTimeFormat)</td>
                        <td>@evenRecord?.Partner</td>
                        <td>@evenRecord?.Username</td>
                        <td>
                            <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                               asp-action="GetSpecialSeDieBetHistory"
                               asp-route-roundId="@Model.RoundResult.Number"
                               asp-route-userId="@evenRecord?.UserId"
                               asp-route-rate="@Model.RoundResult.ExchangeRate">
                                @evenRecord?.Nickname
                            </a>
                        </td>
                        <td>@evenRecord?.Currency</td>
                        <td class="text-right">@HtmlHelpers.convertByExchangeRate(evenRecord?.Amount, Model.RoundResult.ExchangeRate)</td>
                        <td class="text-right">@HtmlHelpers.convertByExchangeRate(evenRecord?.Refund, Model.RoundResult.ExchangeRate)</td>
                        <td class="text-right">@HtmlHelpers.convertByExchangeRate(evenRecord?.BetWin, Model.RoundResult.ExchangeRate)</td>
                        <td class="line-cell"></td>
                        <td>@oddRecord?.Time.ToString(Constants.DateTimeFormat)</td>
                        <td>@oddRecord?.Partner</td>
                        <td>@oddRecord?.Username</td>
                        <td class="col-nickname">
                            <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                               asp-action="GetSpecialSeDieBetHistory"
                               asp-route-roundId="@Model.RoundResult.Number"
                               asp-route-userId="@oddRecord?.UserId"
                               asp-route-rate="@Model.RoundResult.ExchangeRate">
                                @oddRecord?.Nickname
                            </a>
                        </td>
                        <td>@oddRecord?.Currency</td>
                        <td class="text-right">@HtmlHelpers.convertByExchangeRate(oddRecord?.Amount, Model.RoundResult.ExchangeRate)</td>
                        <td class="text-right">@HtmlHelpers.convertByExchangeRate(oddRecord?.Refund, Model.RoundResult.ExchangeRate)</td>
                        <td class="text-right">@HtmlHelpers.convertByExchangeRate(oddRecord?.BetWin, Model.RoundResult.ExchangeRate)</td>
                    </tr>

                }
            </tbody>
            <tfoot>
                @if (totalRow == 0)
                {
                    <tr>
                        <td class="text-center" colspan="17">No data</td>
                    </tr>
                }
                else
                {
                    <tr class="total">
                        <td>Total in @Model.ConvertCurrency</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="text-right">@HtmlHelpers.convertByExchangeRate(evenRecords.Sum(x => x.Amount), Model.RoundResult.ExchangeRate)</td>
                        <td class="text-right">@HtmlHelpers.convertByExchangeRate(evenRecords.Sum(x => x.Refund), Model.RoundResult.ExchangeRate)</td>
                        <td class="text-right">@HtmlHelpers.convertByExchangeRate(evenRecords.Sum(x => x.BetWin), Model.RoundResult.ExchangeRate)</td>
                        <td class="line-cell"></td>
                        <td>Total in @Model.ConvertCurrency</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="text-right">@HtmlHelpers.convertByExchangeRate(oddRecords.Sum(x => x.Amount), Model.RoundResult.ExchangeRate)</td>
                        <td class="text-right">@HtmlHelpers.convertByExchangeRate(oddRecords.Sum(x => x.Refund), Model.RoundResult.ExchangeRate)</td>
                        <td class="text-right">@HtmlHelpers.convertByExchangeRate(oddRecords.Sum(x => x.BetWin), Model.RoundResult.ExchangeRate)</td>
                    </tr>
                }
            </tfoot>
        </table>
    </div>
</div>