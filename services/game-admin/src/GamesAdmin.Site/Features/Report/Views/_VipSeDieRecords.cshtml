@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model VipSeDieReportResultViewModel

<div class="row row-table">
    <div class="col-sm-12">
        @if (Model.RoundResult.Number != 0)
        {
            <table class="table table-bordered  table-hover table-se-die" style="width:100%">
                <thead>
                    <tr>
                        <th>Round ID</th>
                        <th>Exchange ID</th>
                        <th>Results</th>
                        <th>Winning Options</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">@Model.RoundResult.Number</td>
                        <td class="text-center">@Model.RoundResult.ExchangeRateId</td>
                        <td class="text-center">
                            @foreach (var chip in Model.RoundResult.Chips)
                            {
                                if (chip)
                                {
                                    <i class="red-chip"></i>
                                }
                                else
                                {
                                    <i class="white-chip"></i>
                                }
                            }
                        </td>
                        <td class="text-center">
                            @(Model.RoundResult.Even ? "Even" : "Odd")
                            @(Model.RoundResult.TotalRed > 0 ? $", {Model.RoundResult.TotalRed} red" : ", 4 white")
                        </td>
                    </tr>
                </tbody>
            </table>
        }
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th rowspan="2">Round ID</th>
                    <th rowspan="2" class="col-date">Date (GMT+7)</th>
                    <th rowspan="2">Operator</th>
                    <th rowspan="2">Username</th>
                    <th rowspan="2" class="col-nickname">Nickname</th>
                    <th rowspan="2">Currency</th>
                    <th colspan="7" class="col-number">Stake</th>
                    <th rowspan="2" class="col-number">Win</th>
                </tr>

                <tr>
                    <th>Even</th>
                    <th>Odd</th>
                    <th>4 Red</th>
                    <th>3 Red</th>
                    <th>2 Red</th>
                    <th>1 Red</th>
                    <th>4 White</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bet in Model.Records)
                {
                    <tr>
                        <td class="text-center">
                            @Model.RoundResult.Number
                        </td>
                        <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td class="text-center">@bet.Partner</td>
                        <td>@bet.Username</td>
                        <td>
                            @bet.Nickname
                        </td>
                        <td class="text-center">@bet.Currency</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Even) / Model.BaseCurrencyMultiplier : bet.Even)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Odd) / Model.BaseCurrencyMultiplier : bet.Odd)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.FourRed) / Model.BaseCurrencyMultiplier : bet.FourRed)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.ThreeRed) / Model.BaseCurrencyMultiplier : bet.ThreeRed)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.TwoRed) / Model.BaseCurrencyMultiplier : bet.TwoRed)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.ThreeWhite) / Model.BaseCurrencyMultiplier : bet.ThreeWhite)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.FourWhite) / Model.BaseCurrencyMultiplier : bet.FourWhite)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.BaseBetWin / Model.BaseCurrencyMultiplier : bet.BetWin)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @if (!Model.Records.Any())
                {
                    <tr>
                        <td class="text-center" colspan="16">No data</td>
                    </tr>
                }
                else if (Model.ConvertToUSD)
                {
                    <tr class="total">
                        <td>Total in @Model.BaseCurrency</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Even)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Odd)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.FourRed)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.ThreeRed)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.TwoRed)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.ThreeWhite)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.FourWhite)) / Model.BaseCurrencyMultiplier)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.BaseBetWin) / Model.BaseCurrencyMultiplier)</td>
                    </tr>
                }
            </tfoot>
        </table>
    </div>
</div>