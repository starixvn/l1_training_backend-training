@model GamesAdmin.Site.Features.ApiLogs.ViewModels.ApiLogViewModel
@using GamesAdmin.Site._Shared.ViewComponents

@section Styles {
    <link href="~/css/api-log.min.css" rel="stylesheet" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Event Logs";
}

<form class="form filter"
      data-ajax="true"
      data-ajax-mode="replace"
      data-ajax-update="#api-log .card-body"
      data-ajax-loading="#spinner"
      data-ajax-success="apiLog.init"
      asp-action="Query"
      method="post"
      id="api-log-form">
    <div class="form-row align-items-center">
        <div class="col-auto">
            <label asp-for="PartnerId" class="control-label">Operator</label>
            <select asp-items="@Model.Partners" asp-for="PartnerId" class="form-control"></select>
        </div>
        <div class="col-auto">
            <label asp-for="LogType" class="control-label" data-val-query-api-log="Validation">Log Type</label>
            <select asp-items="@Model.LogTypes" asp-for="LogType" class="form-control"></select>
        </div>
        <div class="col-auto">
            <label asp-for="FromDate" class="control-label">From Date (UTC)</label>
            <input type="date" class="form-control" asp-for="FromDate" />
        </div>
        <div class="col-auto">
            <label asp-for="ToDate" class="control-label">To Date (UTC)</label>
            <input type="date" class="form-control" asp-for="ToDate" />
        </div>
        <div class="col-auto">
            <label asp-for="ObCustId" class="control-label">Customer ID</label>
            <input class="form-control" asp-for="ObCustId" value='' />
        </div>
        <div class="col-auto">
            <label asp-for="SiteId" class="control-label">Site ID</label>
            <input class="form-control" asp-for="SiteId" value='' />
        </div>
        <div class="col-auto">
            <label asp-for="Username" class="control-label">Username</label>
            <input class="form-control" asp-for="Username" value='' />
        </div>
        <div class="col-1">
            <label asp-for="GameTypeId" class="control-label">Game</label>
            @await Component.InvokeAsync(nameof(SelectGame), new { name = "GameTypeId", SelectAll = true })
            
        </div>
        <div class="col-auto">
            <label asp-for="GameRoundId" class="control-label">Game Round</label>
            <input class="form-control" asp-for="GameRoundId" value='' />
        </div>
        <div class="col-auto list-buttons">
            <button type="submit" class="btn-submit" formnovalidate="formnovalidate">Submit</button>
            <div id="spinner" class="spinner-border" style="display: none">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
    </div>
    <span hidden id="error-message" class="text-danger">Please input Customer ID, Game and Game Round</span>
</form>

<div hidden id="api-log" class="card">
    <div class="card-body"></div>
</div>

@section Scripts
{
    <environment include="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
        <script type="text/javascript" src="~/lib/data-tables/datatables.js"></script>
        <script src="~/js/api-log.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/api-log.min.js" asp-append-version="true"></script>
    </environment>
}