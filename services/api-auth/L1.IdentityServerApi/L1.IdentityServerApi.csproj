<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net5.0</TargetFramework>
        <CodeAnalysisRuleSet>..\.sonarlint\l1-apicsharp.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="IdentityServer4" Version="3.1.2" />
        <PackageReference Include="Microsoft.VisualStudio.SlowCheetah" Version="3.2.26">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\L1\L1.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Content Update="Properties\launchSettings.json">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
      <AdditionalFiles Include="..\.sonarlint\l1-api\CSharp\SonarLint.xml" Link="SonarLint.xml" />
    </ItemGroup>
    <ItemGroup>
        <Content Update="appsettings.json">
            <TransformOnBuild>true</TransformOnBuild>
        </Content>
        <Content Update="_Configs\sc1\appsettings.json">
          <TransformOnBuild>true</TransformOnBuild>
        </Content>
        <Content Update="_Configs\sc1\appsettings.LOCAL.json">
          <DependentUpon>appsettings.json</DependentUpon>
          <IsTransformFile>true</IsTransformFile>
        </Content>
        <Content Update="_Configs\sc1\appsettings.PROD.json">
          <DependentUpon>appsettings.json</DependentUpon>
          <IsTransformFile>true</IsTransformFile>
        </Content>
        <Content Update="_Configs\sc1\appsettings.SIT.json">
          <DependentUpon>appsettings.json</DependentUpon>
          <IsTransformFile>true</IsTransformFile>
        </Content>
        <Content Update="_Configs\sc1\appsettings.UAT.json">
          <DependentUpon>appsettings.json</DependentUpon>
          <IsTransformFile>true</IsTransformFile>
        </Content>
    </ItemGroup>
</Project>