@model OW.ApiSimulator.Models.OW.CheckMaintenanceResult

<fieldset>
    <legend>Update Check Maintenance Result</legend>

    <div class="form-group">
        <label asp-for="ErrorCode"></label>
        <input class="form-control" asp-for="ErrorCode" />
    </div>
    <div class="form-group">
        <label asp-for="ErrorDescription"></label>
        <input class="form-control" asp-for="ErrorDescription" />
    </div>
    <div class="form-group">
        <label asp-for="StartTime"></label>
        <input class="form-control" asp-for="StartTime" type="datetime" />
    </div>
    <div class="form-group">
        <label asp-for="EndTime"></label>
        <input class="form-control" asp-for="EndTime" type="datetime" />
    </div>
    <div class="form-group">
        <label asp-for="DelayTime"></label>
        <input class="form-control" asp-for="DelayTime" />
    </div>
</fieldset>
